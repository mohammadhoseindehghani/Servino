@page
@model Servino.Presentation.RazorPagesUI.Areas.Customer.Pages.SecurityModel

@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "امنیت حساب";
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">تنظیمات حساب /</span>
    امنیت حساب
</h4>

<div class="row">
    <div class="col-md-12">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <div class="card mb-4">
            <h5 class="card-header">تغییر رمز عبور</h5>

            <div class="card-body">
                <form method="post" asp-page-handler="ChangePassword">

                    <div class="row">
                        <div class="mb-3 col-md-6 form-password-toggle">
                            <label class="form-label">رمز عبور فعلی</label>
                            <div class="input-group input-group-merge">
                                <input asp-for="CurrentPassword"
                                       type="password"
                                       class="form-control"
                                       autocomplete="current-password" />
                                <span class="input-group-text cursor-pointer">
                                    <i class="ti ti-eye-off"></i>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="mb-3 col-md-6 form-password-toggle">
                            <label class="form-label">رمز عبور جدید</label>
                            <div class="input-group input-group-merge">
                                <input asp-for="NewPassword"
                                       type="password"
                                       class="form-control"
                                       autocomplete="new-password" />
                                <span class="input-group-text cursor-pointer">
                                    <i class="ti ti-eye-off"></i>
                                </span>
                            </div>
                        </div>

                        <div class="mb-3 col-md-6 form-password-toggle">
                            <label class="form-label">تأیید رمز عبور جدید</label>
                            <div class="input-group input-group-merge">
                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control"
                                       autocomplete="new-password" />
                                <span class="input-group-text cursor-pointer">
                                    <i class="ti ti-eye-off"></i>
                                </span>
                            </div>
                        </div>

                        <div class="col-12 mb-4">
                            <h6>الزامات رمز عبور:</h6>
                            <ul class="ps-3 mb-0">
                                <li>حداقل 8 کاراکتر</li>
                                <li>حداقل یک حرف کوچک</li>
                                <li>حداقل یک عدد یا نماد خاص</li>
                            </ul>
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary me-2">
                                بروزرسانی رمز
                            </button>
                            <button type="reset" class="btn btn-label-secondary">
                                لغو
                            </button>
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
