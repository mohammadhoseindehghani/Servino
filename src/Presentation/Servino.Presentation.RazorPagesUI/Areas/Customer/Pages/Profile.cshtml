@page
@model Servino.Presentation.RazorPagesUI.Areas.Customer.Pages.ProfileModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "پروفایل کاربری";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/select2/select2.dist.js"></script>
    <script src="~/vendor/libs/select2/i18n/fa.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">تنظیمات /</span> پروفایل من
</h4>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">اطلاعات حساب کاربری</h5>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                    <i class="ti ti-edit me-1"></i> ویرایش پروفایل
                </button>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-4 mb-4">
                    <img src="@(string.IsNullOrEmpty(Model.Profile.ProfileImagePath) ? "/img/avatars/14.png" : Model.Profile.ProfileImagePath)"
                         alt="Avatar" class="d-block w-px-100 h-px-100 rounded" id="currentAvatar" />
                    <div>
                        <h4>@Model.Profile.FirstName @Model.Profile.LastName</h4>
                        <span class="badge bg-label-secondary">مشتری</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">نام و نام خانوادگی:</label>
                        <p class="fs-5">@Model.Profile.FirstName @Model.Profile.LastName</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">شماره موبایل:</label>
                        <p class="fs-5 ltr text-end">@Model.Profile.MobileNumber</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">ایمیل:</label>
                        <p class="fs-5">@Model.Profile.Email</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">شهر:</label>
                        <p class="fs-5">@(Model.Profile.CityName ?? "تعیین نشده")</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">موجودی کیف پول:</label>
                        <p class="fs-5 text-success">@Model.Profile.Balance.ToString("N0") تومان</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <h5 class="card-header text-danger">منطقه خطر</h5>
            <div class="card-body">
                <div class="alert alert-warning">
                    <h6 class="alert-heading mb-1">آیا مطمئن هستید؟</h6>
                    <p class="mb-0">با حذف حساب کاربری، تمام سوابق شما برای همیشه پاک خواهد شد.</p>
                </div>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">حذف حساب کاربری</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-label-primary">
                <h5 class="modal-title">ویرایش اطلاعات پروفایل</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" enctype="multipart/form-data" id="profileForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="d-flex align-items-start align-items-sm-center gap-4 mb-4">
                        <img src="@(string.IsNullOrEmpty(Model.Profile.ProfileImagePath) ? "/img/avatars/14.png" : Model.Profile.ProfileImagePath)"
                             alt="user-avatar" class="d-block w-px-100 h-px-100 rounded" id="modalAvatar" />
                        <div class="button-wrapper">
                            <label for="upload" class="btn btn-primary me-2 mb-3" tabindex="0">
                                <span class="d-none d-sm-block">انتخاب عکس جدید</span>
                                <i class="ti ti-upload d-block d-sm-none"></i>
                                <input type="file" id="upload" name="upload" class="account-file-input"
                                       hidden accept="image/png,image/jpeg,image/jpg" onchange="previewImage(this)" />
                            </label>
                            <div class="text-muted small">JPG, JPEG یا PNG. حداکثر 5MB</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="firstName" class="form-label">نام <span class="text-danger">*</span></label>
                            <input type="text"
                                   id="firstName"
                                   name="firstName"
                                   value="@Model.Profile.FirstName"
                                   class="form-control"
                                   required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="lastName" class="form-label">نام خانوادگی <span class="text-danger">*</span></label>
                            <input type="text"
                                   id="lastName"
                                   name="lastName"
                                   value="@Model.Profile.LastName"
                                   class="form-control"
                                   required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="cityId" class="form-label">شهر <span class="text-danger">*</span></label>
                            <select class="form-select select2"
                                    id="cityId"
                                    name="cityId"
                                    style="width:100%"
                                    required>
                                <option value="">انتخاب کنید...</option>
                                <option value="1" @(Model.Profile.CityId == 1 ? "selected" : "")>تهران</option>
                                <option value="2" @(Model.Profile.CityId == 2 ? "selected" : "")>اصفهان</option>
                                <option value="3" @(Model.Profile.CityId == 3 ? "selected" : "")>شیراز</option>
                                <option value="4" @(Model.Profile.CityId == 4 ? "selected" : "")>مشهد</option>
                                <option value="5" @(Model.Profile.CityId == 5 ? "selected" : "")>تبریز</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">موبایل (غیرقابل تغییر)</label>
                            <input type="text" class="form-control" value="@Model.Profile.MobileNumber" disabled />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section PageScripts {
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                language: "fa",
                dir: "rtl",
                dropdownParent: $('#editProfileModal')
            });

            $('#editProfileModal').on('show.bs.modal', function () {
                $('#firstName').val('@Model.Profile.FirstName');
                $('#lastName').val('@Model.Profile.LastName');
                $('#cityId').val('@Model.Profile.CityId').trigger('change');
                $('#modalAvatar').attr('src', '@(string.IsNullOrEmpty(Model.Profile.ProfileImagePath) ? "/img/avatars/14.png" : Model.Profile.ProfileImagePath)');
            });
        });

        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#modalAvatar').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        function confirmDelete() {
            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: "این عملیات غیرقابل بازگشت است!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، حذف کن',
                cancelButtonText: 'لغو',
                customClass: {
                    confirmButton: 'btn btn-danger me-3',
                    cancelButton: 'btn btn-label-secondary'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire('حذف شد!', 'حساب شما حذف گردید.', 'success');
                }
            });
        }
    </script>
}