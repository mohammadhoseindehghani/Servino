@page
@model Servino.Presentation.RazorPagesUI.Areas.Admin.Pages.UserManagerModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "مدیریت کاربران";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
}
@section VendorScripts {
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
}

<h4 class="py-3 mb-4"><span class="text-muted fw-light">مدیریت /</span> کاربران</h4>

@if (!string.IsNullOrEmpty(Model.MessageText))
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                title: '@(Model.MessageType == "success" ? "موفق!" : "خطا!")',
                text: '@Html.Raw(Model.MessageText)',
                icon: '@(Model.MessageType == "success" ? "success" : "error")',
                confirmButtonText: 'باشه'
            }).then(() => {
                const url = new URL(window.location);
                url.searchParams.delete('msg');
                url.searchParams.delete('text');
                window.history.replaceState({}, '', url);
            });
        });
    </script>
}

<div class="card">
    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">لیست کاربران (@Model.Users.Count)</h5>
        <div>
            <button class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#addUserOffcanvas">
                <i class="ti ti-plus me-1"></i> افزودن کاربر
            </button>
        </div>
    </div>

    <div class="p-3 border-bottom">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="SearchKey" value="@Model.SearchKey" class="form-control" placeholder="جستجو..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100">بگرد</button>
            </div>
        </form>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>نام کاربر</th>
                    <th>ایمیل / موبایل</th>
                    <th>نقش</th>
                    <th>موجودی</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td><strong>@user.FullName</strong></td>
                        <td>
                            <div class="d-flex flex-column">
                                <span>@user.Email</span>
                                <small class="text-muted">@user.Mobile</small>
                            </div>
                        </td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge bg-label-danger">ادمین</span>
                            }
                            else if (user.Role == "Expert")
                            {

                                <span class="badge bg-label-warning">کارشناس</span>
                            }
                            else
                            {

                                <span class="badge bg-label-info">مشتری</span>
                            }
                        </td>
                        <td>@user.Balance.ToString("N0")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-icon btn-sm btn-label-success charge-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#chargeModal"
                                        data-userid="@user.Id"
                                        data-fullname="@user.FullName">
                                    <i class="ti ti-wallet"></i>
                                </button>
                                <button type="button" class="btn btn-icon btn-sm btn-label-primary edit-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editUserModal"
                                        data-id="@user.Id"
                                        data-fullname="@user.FullName"
                                        data-mobile="@user.Mobile"
                                        data-role="@user.Role"
                                        data-provinceid="@(user.ProvinceId.HasValue? user.ProvinceId.Value : "")"
                                        data-cityid="@(user.CityId.HasValue? user.CityId.Value : "")"
                                        data-profileimage="@(user.ImageUrl ?? "")">
                                    <i class="ti ti-edit"></i>
                                </button>

                                @if (user.Role == "Expert")
                                {
                                    <button type="button" class="btn btn-icon btn-sm btn-label-info services-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#servicesModal"
                                            data-userid="@user.Id"
                                            data-fullname="@user.FullName">
                                        <i class="ti ti-list-check"></i>
                                    </button>

                                }

                                <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" class="d-inline"
                                      onsubmit="return confirm('آیا مطمئن هستید؟');">
                                    <button type="submit" class="btn btn-icon btn-sm btn-label-danger">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="chargeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">شارژ حساب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Charge">
                <div class="modal-body">
                    <input type="hidden" asp-for="ChargeModel.UserId" id="inputChargeUserId" />
                    <p>کاربر: <strong id="lblChargeUserName" class="text-primary"></strong></p>

                    <div class="mb-3">
                        <label class="form-label">مبلغ (ریال)</label>
                        <input type="number" asp-for="ChargeModel.Amount" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات</label>
                        <textarea asp-for="ChargeModel.Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary w-100">انجام تراکنش</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ویرایش کاربر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" asp-page-handler="Edit" id="editUserForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" asp-for="EditModel.Id" id="editUserId" />
                    <input type="hidden" asp-for="EditModel.Role" id="editUserRole" />
                    <input type="hidden" asp-for="EditModel.ProfileImagePath" id="profileImagePath" />

                    <div class="row g-3">
                        <div class="col-md-12 mb-3">
                            <label class="form-label">تصویر پروفایل</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="position-relative">
                                    <img id="currentProfileImage"
                                         src="/img/avatars/1.png"
                                         alt="تصویر پروفایل"
                                         class="rounded-circle border"
                                         style="width: 100px; height: 100px; object-fit: cover;">
                                    <button type="button" id="removeImageBtn" class="btn btn-sm btn-danger position-absolute top-0 end-0 rounded-circle"
                                            style="width: 24px; height: 24px; padding: 0; display: none;">
                                        <i class="ti ti-x" style="font-size: 12px;"></i>
                                    </button>
                                </div>

                                <!-- آپلود فایل جدید -->
                                <div class="flex-grow-1">
                                    <div class="input-group">
                                        <input type="file" class="form-control" id="profileImageUpload" accept="image/*">
                                        <button class="btn btn-outline-secondary" type="button" id="uploadImageBtn">
                                            <i class="ti ti-upload"></i>
                                        </button>
                                    </div>
                                    <small class="text-muted d-block mt-1">
                                        فرمت‌های مجاز: JPG, PNG, GIF. حداکثر حجم: 2MB
                                    </small>
                                    <div id="imageUploadProgress" class="progress mt-2" style="height: 6px; display: none;">
                                        <div class="progress-bar" role="progressbar" style="width: 0%"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">نام</label>
                            <input class="form-control" asp-for="EditModel.FirstName" id="editFirstName" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">نام خانوادگی</label>
                            <input class="form-control" asp-for="EditModel.LastName" id="editLastName" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">موبایل</label>
                            <input class="form-control" asp-for="EditModel.Mobile" id="editMobile" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">استان</label>
                            <select class="form-select" asp-for="EditModel.ProvinceId" id="editProvince">
                                <option value="">انتخاب استان</option>
                                @foreach (var p in Model.Provinces)
                                {
                                    <option value="@p.Id">@p.Title</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">شهر</label>
                            <select class="form-select" asp-for="EditModel.CityId" id="editCity" disabled>
                                <option value="">انتخاب شهر</option>
                            </select>
                        </div>
                    </div>

                    <div id="expertFields" class="mt-4 p-3 bg-light rounded" style="display:none">
                        <h6>اطلاعات متخصص</h6>
                        <div class="mb-3">
                            <label class="form-label">شماره شبا</label>
                            <input asp-for="EditModel.ExpertInfo.ShebaNumber" class="form-control" placeholder="شماره شبا" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">شماره کارت بانکی</label>
                            <input asp-for="EditModel.ExpertInfo.BankCardNumber" class="form-control" placeholder="شماره کارت" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">آدرس</label>
                            <input asp-for="EditModel.ExpertInfo.Address" class="form-control" placeholder="آدرس" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">بیو</label>
                            <textarea asp-for="EditModel.ExpertInfo.Bio" class="form-control" rows="3" placeholder="بیو"></textarea>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="text-warning">رمز جدید (اختیاری)</label>
                        <input asp-for="EditModel.NewPassword" class="form-control" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">ذخیره</button>
                </div>
            </form>
        </div>
    </div>
</div>



<div class="modal fade" id="servicesModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">مدیریت تخصص‌ها</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="UpdateServices">
                <div class="modal-body">
                    <input type="hidden" asp-for="TargetExpertId" id="inputServiceExpertId" />
                    <p>متخصص: <strong id="lblServiceExpertName" class="text-primary"></strong></p>
                    <hr />
                    <div id="servicesListContainer" class="d-flex flex-column gap-2" style="max-height: 300px; overflow-y: auto;">
                        <div class="text-center"><div class="spinner-border text-primary"></div></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">ذخیره تخصص‌ها</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="addUserOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">کاربر جدید</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form method="post" asp-page-handler="Create">
            <div class="mb-3"><label>نام</label><input type="text" asp-for="CreateModel.FirstName" class="form-control" required /></div>
            <div class="mb-3"><label>نام خانوادگی</label><input type="text" asp-for="CreateModel.LastName" class="form-control" required /></div>
            <div class="mb-3"><label>ایمیل</label><input type="email" asp-for="CreateModel.Email" class="form-control" required /></div>
            <div class="mb-3"><label>موبایل</label><input type="text" asp-for="CreateModel.Mobile" class="form-control" required /></div>
            <div class="mb-3"><label>رمز عبور</label><input type="password" asp-for="CreateModel.Password" class="form-control" required /></div>
            <div class="mb-3">
                <label>نقش</label>
                <select asp-for="CreateModel.Role" class="form-select">
                    <option value="Customer">مشتری</option>
                    <option value="Expert">متخصص</option>
                    <option value="Admin">ادمین</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary w-100">ثبت</button>
        </form>
    </div>
</div>

@section PageScripts {
    <script>
        function loadProfileImage(imageUrl) {
            const imgElement = $('#currentProfileImage');
            const hiddenInput = $('#profileImagePath');
            const removeBtn = $('#removeImageBtn');

            if (imageUrl && imageUrl.trim() !== '') {
                let fullImageUrl = imageUrl;
                if (!imageUrl.startsWith('http') && !imageUrl.startsWith('/')) {
                    fullImageUrl = '/uploads/' + imageUrl;
                } else if (imageUrl.startsWith('~')) {
                    fullImageUrl = imageUrl.replace('~', '');
                }
                imgElement.attr('src', fullImageUrl);
                hiddenInput.val(imageUrl);
                removeBtn.show();
            } else {
                imgElement.attr('src', '/assets/img/avatars/default-avatar.png');
                hiddenInput.val('');
                removeBtn.hide();
            }
        }

               function uploadProfileImage(file, userId) {
            return new Promise((resolve, reject) => {
                const formData = new FormData();
                formData.append('file', file);
                formData.append('userId', userId);

                const token = $('#editUserForm input[name="__RequestVerificationToken"]').val();
                if (token) {
                    formData.append('__RequestVerificationToken', token);
                }

                const progressBar = $('#imageUploadProgress .progress-bar');
                const progressContainer = $('#imageUploadProgress');
                progressContainer.show();
                progressBar.css('width', '0%');

                $.ajax({
                    url: '?handler=UploadProfileImage',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    xhr: function () {
                        const xhr = new window.XMLHttpRequest();
                        xhr.upload.addEventListener('progress', function (evt) {
                            if (evt.lengthComputable) {
                                const percent = (evt.loaded / evt.total) * 100;
                                progressBar.css('width', percent + '%');
                            }
                        }, false);
                        return xhr;
                    },
                    success: function (response) {
                        progressContainer.hide();
                        if (response.success) {
                            loadProfileImage(response.imagePath);
                            resolve(response);
                        } else {
                            alert('خطا در آپلود: ' + (response.message || 'نامشخص'));
                            reject(response.message);
                        }
                    },
                    error: function (xhr, status, error) {
                        progressContainer.hide();
                        console.error('Upload error:', status, error, xhr.responseText);
                        alert('خطا در ارتباط با سرور. لطفاً کنسول مرورگر رو چک کنید (F12).');
                        reject(error);
                    }
                });
            });
        }

        function loadCities(provinceId, selectedCityId = null) {
            const citySelect = $('#editCity');
            citySelect.prop('disabled', true).html('<option>در حال بارگذاری...</option>');

            if (!provinceId) {
                citySelect.html('<option value="">انتخاب شهر</option>').prop('disabled', true);
                return;
            }

            $.get('?handler=CitiesByProvince', { provinceId })
                .done(res => {
                    citySelect.empty().append('<option value="">انتخاب شهر</option>');
                    res.forEach(c => citySelect.append(`<option value="${c.id}">${c.title}</option>`));
                    if (selectedCityId) citySelect.val(selectedCityId);
                    citySelect.prop('disabled', false);
                })
                .fail(() => {
                    citySelect.html('<option value="">خطا در بارگذاری</option>').prop('disabled', true);
                });
        }

        function clearExpertFields() {
            $('[name^="EditModel.ExpertInfo"]').val('');
        }

        $(document).on('click', '.edit-btn', function () {
            const btn = $(this);
            const id = btn.data('id');
            const role = btn.data('role');
            const fullName = btn.data('fullname') || '';
            const mobile = btn.data('mobile') || '';
            let provinceId = btn.data('provinceid') || null;
            let cityId = btn.data('cityid') || null;
                    const profileImage = $(this).data('profileimage') || '';
        loadProfileImage(profileImage);

            const names = fullName.trim().split(/\s+/);
            const lastName = names.pop() || '';               
            const firstName = names.join(' ') || '';           

            $('#editUserId').val(id);
            $('#editUserRole').val(role);
            $('#editFirstName').val(firstName);
            $('#editLastName').val(lastName);
            $('#editMobile').val(mobile);

            clearExpertFields();
            $('#expertFields').hide();
            $('#editProvince').val('');
            $('#editCity').html('<option value="">انتخاب شهر</option>').prop('disabled', true);

            if (provinceId) {
                $('#editProvince').val(provinceId);
                loadCities(provinceId, cityId);
            }

            if (role === 'Expert') {
                $('#expertFields').show();
                $.get('?handler=ExpertProfile', { userId: id })
                    .done(data => {
                        if (!data) return;

                        $('[name="EditModel.ExpertInfo.ShebaNumber"]').val(data.shebaNumber || '');
                        $('[name="EditModel.ExpertInfo.BankCardNumber"]').val(data.bankCardNumber || '');
                        $('[name="EditModel.ExpertInfo.Address"]').val(data.address || '');
                        $('[name="EditModel.ExpertInfo.Bio"]').val(data.bio || '');

                        if (data.provinceId && data.cityId) {
                            provinceId = data.provinceId;
                            cityId = data.cityId;
                            $('#editProvince').val(provinceId);
                            loadCities(provinceId, cityId);
                        }
                        if (data.profileImagePath) {
                            loadProfileImage(data.profileImagePath);
                        }
                    });
            }
        });

        $('#uploadImageBtn').on('click', () => $('#profileImageUpload').click());

        $('#profileImageUpload').on('change', function () {
            const file = this.files[0];
            const userId = $('#editUserId').val();
            if (!file || !userId) return alert('کاربر انتخاب نشده');

            if (!['image/jpeg', 'image/png', 'image/gif', 'image/webp'].includes(file.type)) {
                alert('فرمت مجاز نیست');
                return $(this).val('');
            }
            if (file.size > 2 * 1024 * 1024) {
                alert('حجم بیش از ۲ مگابایت');
                return $(this).val('');
            }

            uploadProfileImage(file, userId).then(() => $(this).val(''));
        });

        $('#removeImageBtn').on('click', function () {
            if (!confirm('حذف تصویر؟')) return;

            const userId = $('#editUserId').val();
            if (!userId) return;

            const token = $('#editUserForm input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '?handler=RemoveProfileImage',
                type: 'POST',
                data: {
                    userId: userId,
                    __RequestVerificationToken: token  
                },
                success: function (res) {
                    if (res.success) {
                        loadProfileImage('');
                        alert('تصویر حذف شد');
                    } else {
                        alert(res.message || 'خطا در حذف');
                    }
                },
                error: function () {
                    alert('خطا در ارتباط با سرور');
                }
            });
        });

        $('#editProvince').on('change', function () {
            loadCities($(this).val());
        });

        $('#chargeModal').on('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            $('#inputChargeUserId').val(btn.dataset.userid);
            $('#lblChargeUserName').text(btn.dataset.fullname);
        });

        $('#servicesModal').on('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            const expertId = btn.dataset.userid;
            const fullName = btn.dataset.fullname;

            $('#inputServiceExpertId').val(expertId);
            $('#lblServiceExpertName').text(fullName);

            const container = $('#servicesListContainer');
            container.html('<div class="text-center"><div class="spinner-border text-primary"></div></div>');

            $.get('?handler=ExpertServices', { userId: expertId })
                .done(data => {
                    container.empty();
                    if (data && data.length > 0) {
                        data.forEach(service => {
                            const checked = service.isSelected ? 'checked' : '';
                            const html = `
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedServiceIds"
                                           value="${service.homeServiceId}" id="svc_${service.homeServiceId}" ${checked}>
                                    <label class="form-check-label" for="svc_${service.homeServiceId}">
                                        ${service.homeServiceTitle}
                                    </label>
                                </div>`;
                            container.append(html);
                        });
                    } else {
                        container.append('<p class="text-muted">هیچ خدمتی یافت نشد.</p>');
                    }
                })
                .fail(() => container.html('<p class="text-danger">خطا در بارگذاری خدمات</p>'));
        });
    </script>
}
