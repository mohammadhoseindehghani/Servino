@page
@model Servino.Presentation.RazorPagesUI.Areas.Admin.Pages.UserManagerModel

@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "مدیریت کاربران";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/moment/moment.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/i18n/fa.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
}


<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">مدیریت /</span> کاربران
</h4>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>تعداد نمایش</span>
                        <div class="d-flex align-items-center my-2">
                            <h3 class="mb-0 me-2">@Model.Users.Count</h3>
                        </div>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-primary">
                            <i class="ti ti-users ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-3">لیست کاربران</h5>
        <div class="d-flex justify-content-between align-items-center row pb-2 gap-3 gap-md-0">
            <div class="col-md-6">
                <form method="get">
                    <div class="input-group">
                        <input type="text" class="form-control" name="SearchKey" value="@Model.SearchKey" placeholder="جستجو (نام، ایمیل، موبایل)...">
                        <button class="btn btn-outline-primary" type="submit">جستجو</button>
                        @if (!string.IsNullOrEmpty(Model.SearchKey))
                        {
                            <a asp-page="./UserManager" class="btn btn-outline-secondary">حذف فیلتر</a>
                        }
                    </div>
                </form>
            </div>
            <div class="col-md-6 text-end">
                <button type="button" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#addUserOffcanvas">
                    <i class="ti ti-plus me-1"></i> افزودن کاربر جدید
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>نام کامل</th>
                    <th>اطلاعات تماس</th>
                    <th>نقش</th>
                    <th>موجودی (ریال)</th>
                    <th>تاریخ ثبت‌نام</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        var avatarUrl = string.IsNullOrEmpty(user.ImageUrl)
                        ? "/img/default/userAvatar.png"
                        : user.ImageUrl;

                        <tr>
                            <td>@user.Id</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@avatarUrl" alt="Avatar" class="rounded-circle me-2 object-fit-cover" width="32" height="32">
                                    <div class="d-flex flex-column">
                                        <span class="fw-medium">@user.FullName</span>
                                        @* <small class="text-muted">@user.UserName</small> *@
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex flex-column">
                                    <span class="text-truncate" style="max-width: 150px;">@user.Email</span>
                                    <small class="text-muted" dir="ltr">@user.Mobile</small>
                                </div>
                            </td>
                            <td>
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-label-danger">ادمین</span>
                                }
                                else if (user.Role == "Expert")
                                {

                                    <span class="badge bg-label-warning">کارشناس</span>
                                }
                                else
                                {

                                    <span class="badge bg-label-info">مشتری</span>
                                }
                            </td>
                            <td dir="ltr">@user.Balance.ToString("N0")</td>
                            <td dir="ltr">@user.RegisterDate.ToString("yyyy/MM/dd")</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-icon btn-sm btn-label-success" title="شارژ کیف پول"
                                            data-bs-toggle="modal"
                                            data-bs-target="#chargeBalanceModal"
                                            data-user-id="@user.Id"
                                            data-user-name="@user.FullName">
                                        <i class="ti ti-wallet"></i>
                                    </button>

                                    <button class="btn btn-icon btn-sm btn-label-primary" title="ویرایش">
                                        <i class="ti ti-edit"></i>
                                    </button>

                                    <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" class="d-inline">
                                        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                        <input type="hidden" name="SearchKey" value="@Model.SearchKey" />
                                        <button type="button" class="btn btn-icon btn-sm btn-label-danger confirm-delete"
                                                data-name="@user.FullName">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <i class="ti ti-search fs-2 text-muted mb-2"></i>
                            <p>هیچ کاربری یافت نشد.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex justify-content-center">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="./UserManager" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SearchKey="@Model.SearchKey">قبلی</a>
                </li>
                <li class="page-item active">
                    <span class="page-link">صفحه @Model.PageNumber</span>
                </li>
                <li class="page-item @(Model.Users.Count < Model.PageSize ? "disabled" : "")">
                    <a class="page-link" asp-page="./UserManager" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SearchKey="@Model.SearchKey">بعدی</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<div class="modal fade" id="chargeBalanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">مدیریت موجودی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Charge">
                <div class="modal-body">
                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                    <input type="hidden" name="SearchKey" value="@Model.SearchKey" />

                    <input type="hidden" asp-for="ChargeModel.UserId" id="chargeUserId" />

                    <p class="mb-3">کاربر: <strong id="chargeUserName" class="text-primary"></strong></p>

                    <div class="mb-3">
                        <label class="form-label">مبلغ (ریال)</label>
                        <input type="number" class="form-control text-start" asp-for="ChargeModel.Amount" placeholder="مثلا: 50000 یا -20000" required />
                        <div class="form-text">برای کاهش موجودی از علامت منفی استفاده کنید.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">توضیح (اختیاری)</label>
                        <textarea class="form-control" asp-for="ChargeModel.Description" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">لغو</button>
                    <button type="submit" class="btn btn-primary">ثبت تراکنش</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="addUserOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">افزودن کاربر جدید</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <p class="text-muted">فرم ایجاد کاربر را اینجا قرار دهید...</p>
    </div>
</div>

<script>
    const chargeModal = document.getElementByUserId('chargeBalanceModal');
    chargeModal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const userUserId = button.getAttribute('data-user-id');
        const userName = button.getAttribute('data-user-name');

        document.getElementByUserId('chargeUserUserId').value = userUserId;
        document.getElementByUserId('chargeUserName').textContent = userName;
    });

    document.querySelectorAll('.confirm-delete').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const form = this.closest('form');
            const userName = this.getAttribute('data-name');

            Swal.fire({
                title: 'آیا مطمئن هستید؟',
                text: `کاربر "${userName}" و تمام اطلاعات مربوطه حذف خواهند شد!`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، حذف کن',
                cancelButtonText: 'لغو',
                customClass: {
                    confirmButton: 'btn btn-danger me-3',
                    cancelButton: 'btn btn-label-secondary'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    });
</script>