                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-primary">
                            <i class="ti ti-users ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>مشتریان</span>
                        <div class="d-flex align-items-center my-2">
                            <h3 class="mb-0 me-2">892</h3>
                        </div>
                        <p class="mb-0">کاربران عادی</p>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-info">
                            <i class="ti ti-user ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>کارشناسان</span>
                        <div class="d-flex align-items-center my-2">
                            <h3 class="mb-0 me-2">342</h3>
                        </div>
                        <p class="mb-0">متخصصین فعال</p>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-warning">
                            <i class="ti ti-tool ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>ادمین‌ها</span>
                        <div class="d-flex align-items-center my-2">
                            <h3 class="mb-0 me-2">14</h3>
                        </div>
                        <p class="mb-0">مدیران سیستم</p>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-danger">
                            <i class="ti ti-shield ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="card-title mb-0">مدیریت کاربران</h5>
        <button type="button" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#addUserOffcanvas">
            <i class="ti ti-plus me-1"></i> افزودن کاربر جدید
        </button>
    </div>

    <div class="card-datatable table-responsive">
        <table id="usersTable" class="table table-hover">
            <thead class="border-top">
                <tr>
                    <th></th>
                    <th>آیدی</th>
                    <th>نام کامل</th>
                    <th>ایمیل</th>
                    <th>موبایل</th>
                    <th>نقش</th>
                    <th>موجودی (ریال)</th>
                    <th>وضعیت</th>
                    <th>تاریخ ثبت‌نام</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td></td>
                    <td>101</td>
                    <td>
                        <div class="d-flex align-items-center">
                            <img src="~/img/avatars/1.png" alt="Avatar" class="rounded-circle me-2" width="32" height="32">
                            <div>مهتاب کرامتی</div>
                        </div>
                    </td>
                    <td>violet.dev@example.com</td>
                    <td><bdi dir="ltr">0913 000 0000</bdi></td>
                    <td><span class="badge bg-label-info">مشتری</span></td>
                    <td>2,450,000</td>
                    <td><span class="badge bg-label-success">فعال</span></td>
                    <td>۱۴۰۴/۰۵/۱۲</td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="btn btn-icon btn-sm btn-primary" title="شارژ کیف پول"
                                    data-bs-toggle="modal" data-bs-target="#chargeBalanceModal" data-user-id="101" data-user-name="مهتاب کرامتی">
                                <i class="ti ti-wallet"></i>
                            </button>

                            <button class="btn btn-icon btn-sm btn-warning" title="ویرایش"
                                    data-bs-toggle="offcanvas" data-bs-target="#editUserOffcanvas" data-user-id="101">
                                <i class="ti ti-edit"></i>
                            </button>

                            <button class="btn btn-icon btn-sm btn-info" title="تغییر وضعیت">
                                <i class="ti ti-toggle-left"></i>
                            </button>

                            <button class="btn btn-icon btn-sm btn-danger" title="حذف"
                                    onclick="confirmDelete(101, 'مهتاب کرامتی')">
                                <i class="ti ti-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>

                <tr>
                    <td></td>
                    <td>205</td>
                    <td>
                        <div class="d-flex align-items-center">
                            <img src="~/img/avatars/5.png" alt="Avatar" class="rounded-circle me-2" width="32" height="32">
                            <div>نوید محمدزاده</div>
                        </div>
                    </td>
                    <td>expert@example.com</td>
                    <td><bdi dir="ltr">0912 345 6789</bdi></td>
                    <td><span class="badge bg-label-warning">کارشناس</span></td>
                    <td>8,120,000</td>
                    <td><span class="badge bg-label-success">فعال</span></td>
                    <td>۱۴۰۳/۱۰/۰۳</td>
                    <td><!-- همان دکمه‌ها --></td>
                </tr>

                <tr>
                    <td></td>
                    <td>301</td>
                    <td>
                        <div class="d-flex align-items-center">
                            <img src="~/img/avatars/10.png" alt="Avatar" class="rounded-circle me-2" width="32" height="32">
                            <div>علی احمدی</div>
                        </div>
                    </td>
                    <td>admin@example.com</td>
                    <td><bdi dir="ltr">0912 111 2222</bdi></td>
                    <td><span class="badge bg-label-danger">ادمین</span></td>
                    <td>0</td>
                    <td><span class="badge bg-label-danger">غیرفعال</span></td>
                    <td>۱۴۰۲/۰۱/۱۵</td>
                    <td><!-- همان دکمه‌ها --></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="chargeBalanceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">شارژ کیف پول کاربر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/Admin/Users/ChargeBalance" method="post">
                <div class="modal-body">
                    <input type="hidden" name="UserId" id="chargeUserId" />
                    <p>کاربر: <strong id="chargeUserName"></strong></p>
                    <div class="mb-3">
                        <label class="form-label">مبلغ شارژ (ریال)</label>
                        <input type="text" class="form-control text-start" name="Amount" placeholder="500,000" required />
                        <small class="text-muted">بدون جداکننده هزارگان وارد کنید</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیح (اختیاری)</label>
                        <textarea class="form-control" name="Description" rows="2" placeholder="شارژ دستی توسط ادمین"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">لغو</button>
                    <button type="submit" class="btn btn-primary">شارژ کن</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('[data-bs-target="#chargeBalanceModal"]').forEach(btn => {
        btn.addEventListener('click', function () {
            const userId = this.getAttribute('data-user-id');
            const userName = this.getAttribute('data-user-name');
            document.getElementById('chargeUserId').value = userId;
            document.getElementById('chargeUserName').textContent = userName;
        });
    });

    function confirmDelete(userId, userName) {
        Swal.fire({
            title: 'آیا مطمئن هستید؟',
            text: `کاربر "${userName}" برای همیشه حذف خواهد شد!`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'بله، حذف کن',
            cancelButtonText: 'خیر'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire('حذف شد!', '', 'success');
            }
        });
    }

    new DataTable('#usersTable', {
        language: { url: '/vendor/libs/datatables-bs5/i18n/fa.dist.js' },
        columnDefs: [{ orderable: false, targets: [0, 9] }],
        order: [[1, 'desc']],
        responsive: true
    });
</script>
