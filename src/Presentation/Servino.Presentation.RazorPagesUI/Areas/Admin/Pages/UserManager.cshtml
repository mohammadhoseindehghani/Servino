@page
@model Servino.Presentation.RazorPagesUI.Areas.Admin.Pages.UserManagerModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "مدیریت کاربران";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
}
@section VendorScripts {
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
}

<h4 class="py-3 mb-4"><span class="text-muted fw-light">مدیریت /</span> کاربران</h4>

@if (!string.IsNullOrEmpty(Model.MessageText))
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                title: '@(Model.MessageType == "success" ? "موفق!" : "خطا!")',
                text: '@Html.Raw(Model.MessageText)',
                icon: '@(Model.MessageType == "success" ? "success" : "error")',
                confirmButtonText: 'باشه'
            }).then(() => {
                const url = new URL(window.location);
                url.searchParams.delete('msg');
                url.searchParams.delete('text');
                window.history.replaceState({}, '', url);
            });
        });
    </script>
}

<div class="card">
    <div class="card-header border-bottom d-flex justify-content-between align-items-center">
        <h5 class="card-title mb-0">لیست کاربران (@Model.Users.Count)</h5>
        <div>
            <button class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#addUserOffcanvas">
                <i class="ti ti-plus me-1"></i> افزودن کاربر
            </button>
        </div>
    </div>

    <div class="p-3 border-bottom">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="SearchKey" value="@Model.SearchKey" class="form-control" placeholder="جستجو..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100">بگرد</button>
            </div>
        </form>
    </div>

    <div class="table-responsive text-nowrap">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>نام کاربر</th>
                    <th>ایمیل / موبایل</th>
                    <th>نقش</th>
                    <th>موجودی</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td><strong>@user.FullName</strong></td>
                        <td>
                            <div class="d-flex flex-column">
                                <span>@user.Email</span>
                                <small class="text-muted">@user.Mobile</small>
                            </div>
                        </td>
                        <td>
                            @if (user.Role == "Admin")
                            {
                                <span class="badge bg-label-danger">ادمین</span>
                            }
                            else if (user.Role == "Expert")
                            {

                                <span class="badge bg-label-warning">کارشناس</span>
                            }
                            else
                            {

                                <span class="badge bg-label-info">مشتری</span>
                            }
                        </td>
                        <td>@user.Balance.ToString("N0")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-icon btn-sm btn-label-success charge-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#chargeModal"
                                        data-userid="@user.Id"
                                        data-fullname="@user.FullName">
                                    <i class="ti ti-wallet"></i>
                                </button>

                                <button type="button" class="btn btn-icon btn-sm btn-label-primary edit-btn"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editUserModal"
                                        data-id="@user.Id"
                                        data-fullname="@user.FullName"
                                        data-email="@user.Email"
                                        data-mobile="@user.Mobile"
                                        data-role="@user.Role">
                                    <i class="ti ti-edit"></i>
                                </button>

                                @if (user.Role == "Expert")
                                {
                                    <button type="button" class="btn btn-icon btn-sm btn-label-info services-btn"
                                            onclick="openServicesModal(@user.Id, '@user.FullName')">
                                        <i class="ti ti-list-check"></i>
                                    </button>
                                }

                                <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" class="d-inline" 
                                      onsubmit="return confirm('آیا مطمئن هستید؟');">
                                    <button type="submit" class="btn btn-icon btn-sm btn-label-danger">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="chargeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">شارژ حساب</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Charge">
                <div class="modal-body">
                    <input type="hidden" asp-for="ChargeModel.UserId" id="inputChargeUserId" />
                    <p>کاربر: <strong id="lblChargeUserName" class="text-primary"></strong></p>

                    <div class="mb-3">
                        <label class="form-label">مبلغ (ریال)</label>
                        <input type="number" asp-for="ChargeModel.Amount" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات</label>
                        <textarea asp-for="ChargeModel.Description" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary w-100">انجام تراکنش</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">ویرایش اطلاعات</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="Edit">
                <div class="modal-body">
                    <input type="hidden" asp-for="EditModel.Id" id="inputEditId" />
                    <input type="hidden" asp-for="EditModel.Role" id="inputEditRole" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">نام</label>
                            <input type="text" asp-for="EditModel.FirstName" id="inputEditName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">نام خانوادگی</label>
                            <input type="text" asp-for="EditModel.LastName" id="inputEditFamily" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">موبایل</label>
                            <input type="text" asp-for="EditModel.Mobile" id="inputEditMobile" class="form-control" />
                        </div>

                        <div id="expertFieldsContainer" class="col-12 mt-3 p-3 bg-light rounded" style="display:none;">
                            <h6>اطلاعات متخصص</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">شماره شبا</label>
                                    <input type="text" asp-for="EditModel.ExpertInfo.ShebaNumber" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">شماره کارت</label>
                                    <input type="text" asp-for="EditModel.ExpertInfo.BankCardNumber" class="form-control" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">آدرس</label>
                                    <input type="text" asp-for="EditModel.ExpertInfo.Address" class="form-control" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">بیوگرافی</label>
                                    <textarea asp-for="EditModel.ExpertInfo.Bio" class="form-control" rows="2"></textarea>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 border-top pt-3 mt-3">
                            <label class="form-label text-warning">تغییر رمز عبور (اختیاری)</label>
                            <input type="password" asp-for="EditModel.NewPassword" class="form-control" placeholder="****" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="servicesModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">مدیریت تخصص‌ها</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="UpdateServices">
                <div class="modal-body">
                    <input type="hidden" asp-for="TargetExpertId" id="inputServiceExpertId" />
                    <p>متخصص: <strong id="lblServiceExpertName" class="text-primary"></strong></p>
                    <hr />
                    <div id="servicesListContainer" class="d-flex flex-column gap-2" style="max-height: 300px; overflow-y: auto;">
                        <div class="text-center"><div class="spinner-border text-primary"></div></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">ذخیره تخصص‌ها</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="addUserOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">کاربر جدید</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form method="post" asp-page-handler="Create">
            <div class="mb-3"><label>نام</label><input type="text" asp-for="CreateModel.FirstName" class="form-control" required /></div>
            <div class="mb-3"><label>نام خانوادگی</label><input type="text" asp-for="CreateModel.LastName" class="form-control" required /></div>
            <div class="mb-3"><label>ایمیل</label><input type="email" asp-for="CreateModel.Email" class="form-control" required /></div>
            <div class="mb-3"><label>موبایل</label><input type="text" asp-for="CreateModel.Mobile" class="form-control" required /></div>
            <div class="mb-3"><label>رمز عبور</label><input type="password" asp-for="CreateModel.Password" class="form-control" required /></div>
            <div class="mb-3">
                <label>نقش</label>
                <select asp-for="CreateModel.Role" class="form-select">
                    <option value="Customer">مشتری</option>
                    <option value="Expert">متخصص</option>
                    <option value="Admin">ادمین</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary w-100">ثبت</button>
        </form>
    </div>
</div>

@section PageScripts {
    <script>
        $(document).on('click', '.charge-btn', function () {
            var userId = $(this).data('userid');
            var fullName = $(this).data('fullname');

            $('#inputChargeUserId').val(userId);
            $('#lblChargeUserName').text(fullName);
        });

        $(document).on('click', '.edit-btn', function () {
            var id = $(this).data('id');
            var fullName = $(this).data('fullname');
            var mobile = $(this).data('mobile');
            var role = $(this).data('role');

            var names = fullName.split(' ');
            var fname = names[0];
            var lname = names.slice(1).join(' ');

            $('#inputEditId').val(id);
            $('#inputEditRole').val(role);
            $('#inputEditName').val(fname);
            $('#inputEditFamily').val(lname);
            $('#inputEditMobile').val(mobile);

            if (role === 'Expert') {
                $('#expertFieldsContainer').slideDown();

            } else {
                $('#expertFieldsContainer').slideUp();
            }
        });

        function openServicesModal(userId, userName) {
            $('#inputServiceExpertId').val(userId);
            $('#lblServiceExpertName').text(userName);

            var container = $('#servicesListContainer');
            container.html('<div class="text-center p-3"><div class="spinner-border text-primary"></div></div>');

            var modal = new bootstrap.Modal(document.getElementById('servicesModal'));
            modal.show();

            $.ajax({
                url: '?handler=ExpertServices',
                data: { userId: userId },
                success: function (data) {
                    container.empty();
                    if (!data || data.length === 0) {
                        container.html('<p class="text-muted text-center">سرویسی یافت نشد.</p>');
                        return;
                    }

                    $.each(data, function (i, item) {
                        var checked = item.isSelected ? 'checked' : '';
                        var html = `
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedServiceIds" 
                                value="${item.homeServiceId}" id="srv_${item.homeServiceId}" ${checked}>
                                <label class="form-check-label" for="srv_${item.homeServiceId}">
                                    ${item.homeServiceTitle}
                                </label>
                            </div>`;
                        container.append(html);
                    });
                },
                error: function () {
                    container.html('<p class="text-danger text-center">خطا در دریافت لیست خدمات.</p>');
                }
            });
        }
    </script>
}