@{
  TempData.Keep();
  string? currentPage = Convert.ToString(ViewContext.RouteData.Values["Page"])!;
}

<!-- Menu -->
@* ! Do this simple *@
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">

  @* ! Hide app brand if navbar-full *@
  <div
    class='app-brand demo @((@ViewData["navbarFull"] != null && Convert.ToBoolean(@ViewData["navbarFull"])) ? "d-xl-none" : "")'>
    <a asp-page="/Index" class="app-brand-link">
      <span class="app-brand-logo demo">
        @await Html.PartialAsync("_Partials/_Macros")
      </span>
      <span class="app-brand-text demo menu-text fw-bold">@TempData.Peek("appName")</span>
    </a>

    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
      <i class="ti menu-toggle-icon d-none d-xl-block ti-sm align-middle"></i>
      <i class="ti ti-x d-block d-xl-none ti-sm align-middle"></i>
    </a>
  </div>

  <div class="menu-inner-shadow"></div>

  @* ! Full version menu-items *@
  <ul class="menu-inner py-1">
    

    <!-- Front Pages -->


    <li class='menu-item@(currentPage == "/admin/Dashboard" ? " active" : "")'>
            <a asp-page="/admin/Dashboard" class="menu-link">
            <i class="menu-icon tf-icons ti ti-database"></i>
            <div data-i18n="داشبرد">داشبرد</div>
        </a>
    </li>
    <li class='menu-item@(currentPage == "/admin/Profile" ? " active" : "")'>
        <a asp-page="/admin/Profile" class="menu-link">
            <i class="menu-icon tf-icons ti ti-database"></i>
            <div data-i18n="پروفایل">پروفایل</div>
        </a>
    </li>
        <li class='menu-item@(currentPage == "/admin/UserManager" ? " active" : "")'>
            <a asp-page="/admin/UserManager" class="menu-link">
            <i class="menu-icon tf-icons ti ti-database"></i>
                <div data-i18n="مدیریت کاربران ">مدیریت کاربران </div>
        </a>
    </li>
        <li class='menu-item@(currentPage == "/admin/CategoryManager" ? " active" : "")'>
            <a asp-page="/admin/CategoryManager" class="menu-link">
            <i class="menu-icon tf-icons ti ti-database"></i>
                <div data-i18n="مدیریت دسته بندی ها">مدیریت دسته بندی ها </div>
        </a>
    </li>
        <li class='menu-item@(currentPage == "/admin/HomeServiceManager" ? " active" : "")'>
            <a asp-page="/admin/HomeServiceManager" class="menu-link">
            <i class="menu-icon tf-icons ti ti-database"></i>
            <div data-i18n="مدیریت سرویس ها">مدیریت سرویس ها </div>
        </a>
    </li>
        <li class='menu-item@(currentPage == "/admin/commentManager" ? " active" : "")'>
            <a asp-page="/admin/commentManager" class="menu-link">
            <i class="menu-icon tf-icons ti ti-database"></i>
                <div data-i18n="کامنت ها">کامنت ها </div>
        </a>
    </li>
        <li class='menu-item@(currentPage == "/admin/suggestions" ? " active" : "")'>
            <a asp-page="/admin/suggestions" class="menu-link">
            <i class="menu-icon tf-icons ti ti-database"></i>
                <div data-i18n="پیشنهاد ها ">پیشنهاد ها </div>
        </a>
    </li>
        <li class='menu-item@(currentPage == "/admin/UserCRUD" ? " active" : "")'>
            <a asp-page="/admin/UserCRUD" class="menu-link">
            <i class="menu-icon tf-icons ti ti-database"></i>
            <div data-i18n="ایتم">ایتم </div>
        </a>
    </li>
  </ul>

</aside>
<!-- / Menu -->
