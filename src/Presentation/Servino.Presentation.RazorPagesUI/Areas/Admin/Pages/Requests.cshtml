@page
@using Servino.Domain.Core.RequestAgg.Enum
@using Servino.Framework.Extensions
@model Servino.Presentation.RazorPagesUI.Areas.Admin.Pages.RequestsModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "مدیریت سفارش‌ها";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
}
@section VendorScripts {
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
    <script src="~/vendor/libs/moment/moment.dist.js"></script>
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">مدیریت /</span> لیست کل سفارش‌ها
</h4>

<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-3">جستجو و فیلتر</h5>
        <form method="get" class="d-flex justify-content-between align-items-center row pb-2 gap-3 gap-md-0">
            <div class="col-md-4 user_role">
                <input type="text" name="SearchKey" value="@Model.SearchKey" class="form-control" placeholder="جستجو در عنوان یا توضیحات..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">جستجو</button>
            </div>
        </form>
    </div>

    <div class="table-responsive">
        <table class="table table-hover border-top">
            <thead>
                <tr>
                    <th>شناسه</th>
                    <th>عنوان</th>
                    <th>سرویس</th>
                    <th>شهر</th>
                    <th>وضعیت</th>
                    <th>تاریخ ثبت</th>
                    <th>پیشنهادات</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Requests)
                {
                    <tr>
                        <td>#@item.Id</td>
                        <td>
                            <div class="d-flex flex-column">
                                <span class="fw-medium">@item.Title</span>
                                <small class="text-muted text-truncate" style="max-width: 200px;">...</small>
                            </div>
                        </td>
                        <td>@item.ServiceName</td>
                        <td>@item.CityName</td>
                        <td>
                            @{
                                var statusClass = item.Status switch
                                {
                                    RequestStatus.WaitingForExperts => "bg-label-warning",
                                    RequestStatus.Done => "bg-label-success",
                                    RequestStatus.Canceled => "bg-label-danger",
                                    _ => "bg-label-primary"
                                };
                            }
                            <span class="badge @statusClass">@item.Status</span>
                        </td>
                        <td dir="ltr">@item.CreatedAt.ToShamsi()</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-info"
                                    onclick="loadSuggestions(@item.Id, '@item.Title')">
                                <i class="ti ti-list-details me-1"></i> مشاهده (@item.SuggestionCount)
                            </button>
                        </td>
                        <td>
                            <div class="dropdown">
                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                    <i class="ti ti-dots-vertical"></i>
                                </button>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" href="javascript:void(0);"><i class="ti ti-eye me-1"></i> جزئیات کامل</a>
                                    <a class="dropdown-item text-danger" href="javascript:void(0);"><i class="ti ti-trash me-1"></i> حذف</a>
                                </div>
                            </div>
                        </td>
                    </tr> 
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="suggestionsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-label-info">
                <h5 class="modal-title text-white">پیشنهادات برای: <span id="modalRequestTitle" class="fw-bold"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>متخصص</th>
                                <th>قیمت پیشنهادی</th>
                                <th>تاریخ پیشنهادی</th>
                                <th>مدت کار</th>
                                <th>وضعیت</th>
                            </tr>
                        </thead>
                        <tbody id="suggestionsTableBody">
                        </tbody>
                    </table>
                </div>
                <div id="loadingSpinner" class="text-center p-4" style="display:none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
                <div id="emptyMessage" class="text-center p-4 text-muted" style="display:none;">
                    <i class="ti ti-ghost fs-2 mb-2"></i>
                    <p>هیچ پیشنهادی برای این درخواست ثبت نشده است.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

@section PageScripts {
    <script>
        function loadSuggestions(requestId, requestTitle) {
            $('#modalRequestTitle').text(requestTitle);
            $('#suggestionsTableBody').empty();
            $('#emptyMessage').hide();
            $('#loadingSpinner').show();

            var myModal = new bootstrap.Modal(document.getElementById('suggestionsModal'));
            myModal.show();

            $.ajax({
                url: '?handler=RequestSuggestions', 
                type: 'GET',
                data: { requestId: requestId },
                success: function (data) {
                    $('#loadingSpinner').hide();

                    if (!data || data.length === 0) {
                        $('#emptyMessage').show();
                        return;
                    }

                    $.each(data, function (index, item) {
                        var statusBadge = '';
                        if(item.status === 1) statusBadge = '<span class="badge bg-label-warning">در انتظار</span>';
                        else if(item.status === 2) statusBadge = '<span class="badge bg-label-success">پذیرفته شده</span>';
                        else statusBadge = '<span class="badge bg-label-danger">رد شده</span>';

                        var dateStr = new Date(item.suggestedDate).toLocaleDateString('fa-IR');

                        var row = `
                            <tr>
                                <td>
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold text-dark">${item.expertFullName}</span>
                                        <small class="text-muted">${item.expertMobile ?? '-'}</small>
                                    </div>
                                </td>
                                <td class="text-primary fw-bold">${item.suggestedPrice.toLocaleString()} تومان</td>
                                <td>${dateStr}</td>
                                <td>${item.estimatedDurationHours} ساعت</td>
                                <td>${statusBadge}</td>
                            </tr>
                        `;
                        $('#suggestionsTableBody').append(row);
                    });
                },
                error: function () {
                    $('#loadingSpinner').hide();
                    $('#suggestionsTableBody').html('<tr><td colspan="5" class="text-center text-danger">خطا در دریافت اطلاعات</td></tr>');
                }
            });
        }
    </script>
}