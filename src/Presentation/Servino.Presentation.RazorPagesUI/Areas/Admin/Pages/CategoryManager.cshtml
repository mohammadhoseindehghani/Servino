@page
@model Servino.Presentation.RazorPagesUI.Areas.Admin.Pages.CategoryManagerModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "مدیریت دسته‌بندی‌ها";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css">
}

@section VendorScripts {
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/i18n/fa.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">مدیریت محتوا /</span> دسته‌بندی‌های خدمات
</h4>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>کل دسته‌بندی‌ها</span>
                        <h3 class="mb-0 me-2">48</h3>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-primary">
                            <i class="ti ti-category ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>فعال</span>
                        <h3 class="mb-0 me-2 text-success">42</h3>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-success">
                            <i class="ti ti-check ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>غیرفعال</span>
                        <h3 class="mb-0 me-2 text-danger">6</h3>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-danger">
                            <i class="ti ti-x ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>دسته اصلی</span>
                        <h3 class="mb-0 me-2">12</h3>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-info">
                            <i class="ti ti-folders ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="card-title mb-0">لیست دسته‌بندی‌ها</h5>
        <button type="button" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#addCategoryOffcanvas">
            <i class="ti ti-plus me-1"></i> افزودن دسته‌بندی جدید
        </button>
    </div>

    <div class="card-datatable table-responsive">
        <table id="categoriesTable" class="dt-fixedheader table table-hover">
            <thead class="table-light">
                <tr>
                    <th></th>
                    <th>تصویر</th>
                    <th>عنوان دسته‌بندی</th>
                    <th>دسته والد</th>
                    <th>تعداد زیرمجموعه</th>
                    <th>تعداد خدمات</th>
                    <th>وضعیت</th>
                    <th>تاریخ ایجاد</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td></td>
                    <td>
                        <img src="~/img/categories/cleaning.png" class="rounded" width="40" height="40" alt="تمیزکاری">
                    </td>
                    <td><strong>تمیزکاری و نظافت</strong></td>
                    <td><span class="text-muted">— (اصلی)</span></td>
                    <td>8</td>
                    <td>24</td>
                    <td><span class="badge bg-label-success">فعال</span></td>
                    <td>۱۴۰۴/۰۴/۱۰</td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="btn btn-icon btn-sm btn-warning" title="ویرایش"
                                    data-bs-toggle="offcanvas" data-bs-target="#editCategoryOffcanvas" data-id="1">
                                <i class="ti ti-edit"></i>
                            </button>
                            <button class="btn btn-icon btn-sm btn-info" title="تغییر وضعیت">
                                <i class="ti ti-toggle-left"></i>
                            </button>
                            <button class="btn btn-icon btn-sm btn-danger" title="حذف"
                                    onclick="confirmCategoryDelete(1, 'تمیزکاری و نظافت')">
                                <i class="ti ti-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td></td>
                    <td>
                        <img src="~/img/categories/plumbing.png" class="rounded" width="40" height="40" alt="لوله‌کشی">
                    </td>
                    <td>   └─ لوله‌کشی و تأسیسات</td>
                    <td>تمیزکاری و نظافت</td>
                    <td>3</td>
                    <td>15</td>
                    <td><span class="badge bg-label-success">فعال</span></td>
                    <td>۱۴۰۴/۰۴/۱۵</td>
                    <td><!-- همان دکمه‌ها --></td>
                </tr>
                <tr>
                    <td></td>
                    <td>
                        <img src="~/img/categories/repair.png" class="rounded" width="40" height="40" alt="تعمیرات">
                    </td>
                    <td><strong>تعمیرات لوازم خانگی</strong></td>
                    <td><span class="text-muted">— (اصلی)</span></td>
                    <td>5</td>
                    <td>32</td>
                    <td><span class="badge bg-label-danger">غیرفعال</span></td>
                    <td>۱۴۰۳/۱۲/۰۵</td>
                    <td><!-- همان دکمه‌ها --></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#categoriesTable').DataTable({
            language: {
                url: '/vendor/libs/datatables-bs5/i18n/fa.dist.js'
            },
            fixedHeader: true,
            responsive: true,
            columnDefs: [
                { orderable: false, targets: [0, 1, 8] },
                { className: "text-center", targets: [1, 4, 5, 6] }
            ],
            order: [[2, 'asc']],
            pageLength: 25
        });
    });

    function confirmCategoryDelete(id, title) {
        Swal.fire({
            title: 'آیا از حذف مطمئن هستید؟',
            text: `"${title}" و تمام زیرمجموعه‌های آن حذف خواهند شد!`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'بله، حذف کن',
            cancelButtonText: 'لغو',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire('حذف شد!', 'دسته‌بندی با موفقیت حذف گردید.', 'success');
            }
        });
    }
</script>

<div class="offcanvas offcanvas-end" tabindex="-1" id="addCategoryOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">افزودن دسته‌بندی جدید</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form>
            <div class="mb-3">
                <label class="form-label">عنوان دسته‌بندی</label>
                <input type="text" class="form-control" placeholder="مثال: برق‌کاری ساختمان" required />
            </div>
            <div class="mb-3">
                <label class="form-label">دسته والد (اختیاری)</label>
                <select class="select2 form-select">
                    <option value="">— دسته اصلی —</option>
                    <option value="1">تمیزکاری و نظافت</option>
                    <option value="2">تعمیرات لوازم خانگی</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">تصویر دسته‌بندی</label>
                <input type="file" class="form-control" accept="image/*" />
            </div>
            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="isActiveAdd" checked />
                <label class="form-check-label" for="isActiveAdd">فعال باشد</label>
            </div>
            <div class="text-end">
                <button type="button" class="btn btn-label-secondary me-2" data-bs-dismiss="offcanvas">لغو</button>
                <button type="submit" class="btn btn-primary">ذخیره</button>
            </div>
        </form>
    </div>
</div>