@page
@model Servino.Presentation.RazorPagesUI.Areas.Admin.Pages.CategoryManagerModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "مدیریت دسته‌بندی‌ها";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css">
}

@section VendorScripts {
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/i18n/fa.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
}

@if (TempData["SuccessMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            Swal.fire({
                title: 'موفق!',
                text: '@Html.Raw(TempData["SuccessMessage"])', 
                icon: 'success',
                confirmButtonText: 'باشه'
            });
        });
    </script>
}

@if (TempData["ErrorMessage"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            Swal.fire({
                title: 'خطا!',
                text: '@Html.Raw(TempData["ErrorMessage"])', 
                icon: 'error',
                confirmButtonText: 'باشه'
            });
        });
    </script>
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">مدیریت محتوا /</span> دسته‌بندی‌های خدمات
</h4>

<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-3">لیست دسته‌بندی‌ها</h5>
        <div class="d-flex justify-content-between align-items-center row pb-2 gap-3 gap-md-0">
            <div class="col-md-6">
                <form method="get">
                    <div class="input-group">
                        <input type="text" class="form-control" name="SearchKey" value="@Model.SearchKey" placeholder="جستجو در عنوان...">
                        <button class="btn btn-outline-primary" type="submit">جستجو</button>
                        @if (!string.IsNullOrEmpty(Model.SearchKey))
                        {
                            <a asp-page="./CategoryManager" class="btn btn-outline-secondary">حذف فیلتر</a>
                        }
                    </div>
                </form>
            </div>
            <div class="col-md-6 text-end">
                <button type="button" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#addCategoryOffcanvas">
                    <i class="ti ti-plus me-1"></i> افزودن دسته‌بندی جدید
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>تصویر</th>
                    <th>عنوان دسته‌بندی</th>
                    <th>دسته والد</th>
                    <th class="text-center">زیرمجموعه</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Categories.Any())
                {
                    @foreach (var item in Model.Categories)
                    {
                        var imgPath = !string.IsNullOrEmpty(item.ImagePath) ? item.ImagePath : "/img/default/category-placeholder.png";

                        <tr>
                            <td>@item.Id</td>
                            <td>
                                <img src="@imgPath" class="rounded object-fit-cover" width="40" height="40" alt="category">
                            </td>
                            <td><strong>@item.Title</strong></td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ParentTitle))
                                {
                                    <span class="text-body">@item.ParentTitle</span>
                                }
                                else
                                {
                                    <span class="text-muted">— (اصلی)</span>
                                }
                            </td>
                            <td class="text-center">@item.SubCategoriesCount</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-icon btn-sm btn-label-warning" title="ویرایش"
                                            onclick="openEditModal(@item.Id)">
                                        <i class="ti ti-edit"></i>
                                    </button>

                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                        <input type="hidden" name="SearchKey" value="@Model.SearchKey" />
                                        <button type="button" class="btn btn-icon btn-sm btn-label-danger confirm-delete"
                                                data-title="@item.Title">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            <i class="ti ti-search fs-2 text-muted mb-2"></i>
                            <p>داده‌ای یافت نشد.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex justify-content-center">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="./CategoryManager" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SearchKey="@Model.SearchKey">قبلی</a>
                </li>
                <li class="page-item active">
                    <span class="page-link">صفحه @Model.PageNumber</span>
                </li>
                <li class="page-item @(Model.Categories.Count < Model.PageSize ? "disabled" : "")">
                    <a class="page-link" asp-page="./CategoryManager" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SearchKey="@Model.SearchKey">بعدی</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="addCategoryOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">افزودن دسته‌بندی جدید</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form method="post" asp-page-handler="Create" enctype="multipart/form-data">
            <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
            <input type="hidden" name="SearchKey" value="@Model.SearchKey" />

            <div class="mb-3">
                <label class="form-label">عنوان دسته‌بندی</label>
                <input type="text" class="form-control" asp-for="CreateInput.Title" placeholder="مثال: برق‌کاری" required />
            </div>

            <div class="mb-3">
                <label class="form-label">دسته والد (اختیاری)</label>
                <select class="form-select" asp-for="CreateInput.ParentId" asp-items="Model.ParentCategories">
                    <option value="">— دسته اصلی —</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">تصویر دسته‌بندی</label>
                <input type="file" class="form-control" asp-for="CreateInput.ImageFile" accept="image/*" />
            </div>

            <div class="text-end">
                <button type="button" class="btn btn-label-secondary me-2" data-bs-dismiss="offcanvas">لغو</button>
                <button type="submit" class="btn btn-primary">ذخیره</button>
            </div>
        </form>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="editCategoryOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">ویرایش دسته‌بندی</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">

        <div id="editLoader" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">در حال بارگذاری...</p>
        </div>

        <form id="editForm" method="post" asp-page-handler="Edit" enctype="multipart/form-data" style="display:none;">
            <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
            <input type="hidden" name="SearchKey" value="@Model.SearchKey" />

            <input type="hidden" id="editId" asp-for="EditInput.Id" />

            <div class="mb-3">
                <label class="form-label">عنوان دسته‌بندی</label>
                <input type="text" class="form-control" id="editTitle" asp-for="EditInput.Title" required />
            </div>

            <div class="mb-3">
                <label class="form-label">دسته والد (اختیاری)</label>
                <select class="form-select" id="editParentId" asp-for="EditInput.ParentId" asp-items="Model.ParentCategories">
                    <option value="">— دسته اصلی —</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">تصویر جدید (اختیاری)</label>
                <input type="file" class="form-control" asp-for="EditInput.ImageFile" accept="image/*" />
                <div class="form-text">اگر تصویری انتخاب نکنید، تصویر قبلی باقی می‌ماند.</div>
            </div>

            <div class="text-end">
                <button type="button" class="btn btn-label-secondary me-2" data-bs-dismiss="offcanvas">لغو</button>
                <button type="submit" class="btn btn-warning">ویرایش تغییرات</button>
            </div>
        </form>
    </div>
</div>


    <script>
        document.querySelectorAll('.confirm-delete').forEach(btn => {
            btn.addEventListener('click', function(e) {
                e.preventDefault();
                const form = this.closest('form');
                const title = this.getAttribute('data-title');

                Swal.fire({
                    title: 'حذف دسته‌بندی',
                    text: `آیا از حذف "${title}" مطمئن هستید؟ زیرمجموعه‌های آن نیز ممکن است حذف شوند.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'بله، حذف کن',
                    cancelButtonText: 'لغو',
                    customClass: {
                        confirmButton: 'btn btn-danger me-3',
                        cancelButton: 'btn btn-label-secondary'
                    },
                    buttonsStyling: false
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });

        let editOffcanvas;

        document.addEventListener("DOMContentLoaded", function () {
            var element = document.getElementByUserId('editCategoryOffcanvas');
            if (element) {
                editOffcanvas = new bootstrap.Offcanvas(element);
            }
        });

        function openEditModal(id) {
            if (!editOffcanvas) {
                var element = document.getElementByUserId('editCategoryOffcanvas');
                editOffcanvas = new bootstrap.Offcanvas(element);
            }

            editOffcanvas.show();

            document.getElementByUserId('editLoader').style.display = 'block';
            document.getElementByUserId('editForm').style.display = 'none';

            fetch(`?handler=RowData&id=${id}`)
                .then(response => {
                    if (!response.ok) throw new Error('Network response was not ok');
                    return response.json();
                })
                .then(data => {
                    document.getElementByUserId('editUserId').value = data.id;
                    document.getElementByUserId('editTitle').value = data.title;

                    const parentSelect = document.getElementByUserId('editParentUserId');
                    if (data.parentUserId) {
                        parentSelect.value = data.parentUserId;
                    } else {
                        parentSelect.value = "";
                    }

                    document.getElementByUserId('editLoader').style.display = 'none';
                    document.getElementByUserId('editForm').style.display = 'block';
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire('خطا', 'مشکلی در دریافت اطلاعات رخ داد.', 'error');
                    editOffcanvas.hide();
                });
        }
    </script>
