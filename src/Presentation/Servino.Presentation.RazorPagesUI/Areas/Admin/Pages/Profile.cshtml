@page
@model Servino.Presentation.RazorPagesUI.Areas.Admin.Pages.ProfileModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "پروفایل ادمین";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/select2/select2.dist.js"></script>
    <script src="~/vendor/libs/select2/i18n/fa.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">تنظیمات /</span> پروفایل ادمین
</h4>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @Model.SuccessMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-12">

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">اطلاعات کاربری</h5>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#editAdminModal">
                    <i class="ti ti-edit me-1"></i> ویرایش پروفایل
                </button>
            </div>

            <div class="card-body">
                <div class="d-flex align-items-center gap-4 mb-4">
                    <img src="@(string.IsNullOrEmpty(Model.Profile.ProfileImagePath) ? "/img/avatars/14.png" : Model.Profile.ProfileImagePath)"
                         alt="Avatar" class="d-block w-px-100 h-px-100 rounded" />
                    <div>
                        <h4>@Model.Profile.FirstName @Model.Profile.LastName</h4>
                        <span class="badge bg-label-danger">مدیر سیستم (Admin)</span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">نام و نام خانوادگی:</label>
                        <p class="fs-5">@Model.Profile.FirstName @Model.Profile.LastName</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">شماره موبایل:</label>
                        <p class="fs-5 ltr text-end">@Model.Profile.MobileNumber</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">ایمیل:</label>
                        <p class="fs-5">@Model.Profile.Email</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">شهر:</label>
                        <p class="fs-5">@Model.Profile.CityName</p>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">تاریخ ثبت نام:</label>
                        <p class="fs-5">@Model.Profile.RegisterDate.ToShortDateString()</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="editAdminModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-label-primary">
                <h5 class="modal-title">ویرایش اطلاعات ادمین</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form method="post" enctype="multipart/form-data">
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UpdateCommand.Id" />

                    <div class="d-flex align-items-start align-items-sm-center gap-4 mb-4">
                        <img src="@(string.IsNullOrEmpty(Model.Profile.ProfileImagePath) ? "/img/avatars/14.png" : Model.Profile.ProfileImagePath)"
                             alt="user-avatar" class="d-block w-px-100 h-px-100 rounded" id="modalAvatar" />

                        <div class="button-wrapper">
                            <label for="upload" class="btn btn-primary me-2 mb-3" tabindex="0">
                                <span class="d-none d-sm-block">انتخاب عکس جدید</span>
                                <i class="ti ti-upload d-block d-sm-none"></i>
                                <input type="file" id="upload" asp-for="Upload" class="account-file-input" hidden accept="image/png,image/jpeg,image/jpg" onchange="previewImage(this)" />
                            </label>
                            <div class="text-muted small">JPG, GIF or PNG. Max size of 5MB</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="UpdateCommand.FirstName" class="form-label">نام</label>
                            <input type="text" asp-for="UpdateCommand.FirstName" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="UpdateCommand.LastName" class="form-label">نام خانوادگی</label>
                            <input type="text" asp-for="UpdateCommand.LastName" class="form-control" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="UpdateCommand.CityId" class="form-label">شهر</label>
                            <select class="form-select select2" asp-for="UpdateCommand.CityId" style="width:100%">
                                <option value="">انتخاب کنید...</option>
                                <option value="1">تهران</option>
                                <option value="2">اصفهان</option>
                                <option value="3">شیراز</option>
                                <option value="4">مشهد</option>
                                <option value="5">تبریز</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">موبایل</label>
                            <input type="text" class="form-control" value="@Model.Profile.MobileNumber" disabled />
                            <small class="text-muted">تغییر شماره موبایل فقط از طریق پشتیبانی امکان‌پذیر است.</small>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-label-secondary" data-bs-dismiss="modal">انصراف</button>
                    <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section PageScripts {
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                language: "fa",
                dir: "rtl",
                dropdownParent: $('#editAdminModal')
            });
        });

        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#modalAvatar').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        @if (!ModelState.IsValid || !string.IsNullOrEmpty(Model.ErrorMessage))
        {
                <text>
                    var myModal = new bootstrap.Modal(document.getElementByUserId('editAdminModal'));
                    myModal.show();
                </text>
        }
    </script>
}