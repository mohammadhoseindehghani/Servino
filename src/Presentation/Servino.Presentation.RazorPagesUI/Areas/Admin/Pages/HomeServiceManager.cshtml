@page
@model Servino.Presentation.RazorPagesUI.Areas.Admin.Pages.HomeServiceManagerModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "مدیریت خدمات خانگی";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css">
}

@section VendorScripts {
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/i18n/fa.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
}
<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">مدیریت محتوا /</span> خدمات خانگی
</h4>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>تعداد خدمات</span>
                        <h3 class="mb-0 me-2">@Model.Services.Count</h3>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-primary">
                            <i class="ti ti-tool ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-3">لیست خدمات خانگی</h5>
        <div class="d-flex justify-content-between align-items-center row pb-2 gap-3 gap-md-0">
            <div class="col-md-6">
                <form method="get">
                    <div class="input-group">
                        <input type="text" class="form-control" name="SearchKey" value="@Model.SearchKey" placeholder="جستجو در عنوان...">
                        <button class="btn btn-outline-primary" type="submit">جستجو</button>
                        @if (!string.IsNullOrEmpty(Model.SearchKey))
                        {
                            <a asp-page="./HomeServiceManager" class="btn btn-outline-secondary">حذف فیلتر</a>
                        }
                    </div>
                </form>
            </div>
            <div class="col-md-6 text-end">
                <button type="button" class="btn btn-primary" data-bs-toggle="offcanvas" data-bs-target="#addServiceOffcanvas">
                    <i class="ti ti-plus me-1"></i> افزودن خدمت جدید
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>تصویر</th>
                    <th>عنوان خدمت</th>
                    <th>دسته‌بندی</th>
                    <th>قیمت پایه</th>
                    <th>بازدید</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Services.Any())
                {
                    @foreach (var item in Model.Services)
                    {
                        var imgPath = !string.IsNullOrEmpty(item.ImagePath) ? item.ImagePath : "/img/default/service-placeholder.png";

                        <tr>
                            <td>@item.Id</td>
                            <td>
                                <img src="@imgPath" class="rounded object-fit-cover" width="50" height="50" alt="service">
                            </td>
                            <td>
                                <div>
                                    <strong>@item.Title</strong>
                                </div>
                            </td>
                            <td><span class="badge bg-label-secondary">@item.CategoryName</span></td>
                            <td><strong>@item.BasePrice</strong> ریال</td>
                            <td>@item.VisitCount</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-icon btn-sm btn-label-warning" title="ویرایش"
                                            onclick="openEditModal(@item.Id)">
                                        <i class="ti ti-edit"></i>
                                    </button>

                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                        <input type="hidden" name="SearchKey" value="@Model.SearchKey" />
                                        <button type="button" class="btn btn-icon btn-sm btn-label-danger confirm-delete"
                                                data-title="@item.Title">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <i class="ti ti-search fs-2 text-muted mb-2"></i>
                            <p>هیچ خدمتی یافت نشد.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex justify-content-center">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="./HomeServiceManager" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SearchKey="@Model.SearchKey">قبلی</a>
                </li>
                <li class="page-item active">
                    <span class="page-link">صفحه @Model.PageNumber</span>
                </li>
                <li class="page-item @(Model.Services.Count < Model.PageSize ? "disabled" : "")">
                    <a class="page-link" asp-page="./HomeServiceManager" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SearchKey="@Model.SearchKey">بعدی</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="addServiceOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">افزودن خدمت جدید</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <form method="post" asp-page-handler="Create" enctype="multipart/form-data">
            <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
            <input type="hidden" name="SearchKey" value="@Model.SearchKey" />

            <div class="mb-3">
                <label class="form-label">عنوان خدمت</label>
                <input type="text" class="form-control" asp-for="CreateInput.Title" placeholder="مثال: تعمیر پکیج" required />
            </div>
            <div class="mb-3">
                <label class="form-label">توضیح کوتاه</label>
                <textarea class="form-control" rows="3" asp-for="CreateInput.ShortDescription" placeholder="توضیح مختصر..."></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">دسته‌بندی</label>
                <select class="form-select" asp-for="CreateInput.CategoryId" asp-items="Model.Categories" required>
                    <option value="">انتخاب دسته‌بندی</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">قیمت پایه (ریال)</label>
                <input type="number" class="form-control" asp-for="CreateInput.BasePrice" required />
            </div>
            <div class="mb-3">
                <label class="form-label">تصویر خدمت</label>
                <input type="file" class="form-control" asp-for="CreateInput.ImageFile" accept="image/*" />
            </div>

            <div class="text-end">
                <button type="button" class="btn btn-label-secondary me-2" data-bs-dismiss="offcanvas">لغو</button>
                <button type="submit" class="btn btn-primary">ذخیره خدمت</button>
            </div>
        </form>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="editServiceOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">ویرایش خدمت</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div id="editLoader" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">در حال دریافت اطلاعات...</p>
        </div>

        <form id="editForm" method="post" asp-page-handler="Edit" enctype="multipart/form-data" style="display:none;">
            <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
            <input type="hidden" name="SearchKey" value="@Model.SearchKey" />

            <input type="hidden" id="editId" asp-for="EditInput.Id" />

            <div class="mb-3">
                <label class="form-label">عنوان خدمت</label>
                <input type="text" class="form-control" id="editTitle" asp-for="EditInput.Title" required />
            </div>
            <div class="mb-3">
                <label class="form-label">توضیح کوتاه</label>
                <textarea class="form-control" rows="3" id="editDesc" asp-for="EditInput.ShortDescription"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">دسته‌بندی</label>
                <select class="form-select" id="editCategory" asp-for="EditInput.CategoryId" asp-items="Model.Categories" required>
                    <option value="">انتخاب دسته‌بندی</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">قیمت پایه (ریال)</label>
                <input type="number" class="form-control" id="editPrice" asp-for="EditInput.BasePrice" required />
            </div>
            <div class="mb-3">
                <label class="form-label">تصویر جدید (اختیاری)</label>
                <input type="file" class="form-control" asp-for="EditInput.ImageFile" accept="image/*" />
                <div class="form-text">اگر تصویری انتخاب نکنید، تصویر قبلی حفظ می‌شود.</div>
            </div>

            <div class="text-end">
                <button type="button" class="btn btn-label-secondary me-2" data-bs-dismiss="offcanvas">لغو</button>
                <button type="submit" class="btn btn-warning">ویرایش تغییرات</button>
            </div>
        </form>
    </div>
</div>

<script>
    document.querySelectorAll('.confirm-delete').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const form = this.closest('form');
            const title = this.getAttribute('data-title');

            Swal.fire({
                title: 'حذف خدمت',
                text: `آیا از حذف "${title}" مطمئن هستید؟`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، حذف کن',
                cancelButtonText: 'لغو',
                customClass: {
                    confirmButton: 'btn btn-danger me-3',
                    cancelButton: 'btn btn-label-secondary'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    });

         let editOffcanvas;

         document.addEventListener("DOMContentLoaded", function () {
             var element = document.getElementByUserId('editServiceOffcanvas');
             if (element) {
                 editOffcanvas = new bootstrap.Offcanvas(element);
             }
         });

         function openEditModal(id) {
             if (!editOffcanvas) {
                 var element = document.getElementByUserId('editServiceOffcanvas');
                 editOffcanvas = new bootstrap.Offcanvas(element);
             }

             editOffcanvas.show();

             document.getElementByUserId('editLoader').style.display = 'block';
             document.getElementByUserId('editForm').style.display = 'none';

             fetch(`?handler=RowData&id=${id}`)
                 .then(response => {
                     if (!response.ok) throw new Error('Network response was not ok');
                     return response.json();
                 })
                 .then(data => {
                     document.getElementByUserId('editUserId').value = data.id;
                     document.getElementByUserId('editTitle').value = data.title;
                     document.getElementByUserId('editDesc').value = data.shortDescription;
                     document.getElementByUserId('editCategory').value = data.categoryUserId;
                     document.getElementByUserId('editPrice').value = data.basePrice;

                     document.getElementByUserId('editLoader').style.display = 'none';
                     document.getElementByUserId('editForm').style.display = 'block';
                 })
                 .catch(error => {
                     console.error('Error:', error);
                     Swal.fire('خطا', 'مشکلی در دریافت اطلاعات رخ داد.', 'error');
                 });
         }
</script>