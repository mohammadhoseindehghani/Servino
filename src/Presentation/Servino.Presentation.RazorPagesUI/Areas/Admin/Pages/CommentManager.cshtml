@page
@using Servino.Framework.Extensions
@model Servino.Presentation.RazorPagesUI.Areas.Admin.Pages.CommentManagerModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "مدیریت نظرات کاربران";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css">
}

@section VendorScripts {
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/i18n/fa.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">مدیریت محتوا /</span> نظرات کاربران
</h4>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>تعداد در صفحه</span>
                        <h3 class="mb-0 me-2">@Model.Comments.Count</h3>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-primary">
                            <i class="ti ti-message-circle ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header border-bottom">
        <h5 class="card-title mb-3">لیست نظرات کاربران</h5>
        <div class="d-flex justify-content-between align-items-center row pb-2 gap-3 gap-md-0">
            <div class="col-md-6 user_plan">
                <form method="get">
                    <div class="input-group">
                        <input type="text" class="form-control" name="SearchKey" value="@Model.SearchKey" placeholder="جستجو در متن یا عنوان...">
                        <button class="btn btn-outline-primary" type="submit">جستجو</button>
                        @if (!string.IsNullOrEmpty(Model.SearchKey))
                        {
                            <a asp-page="./CommentManager" class="btn btn-outline-secondary">حذف فیلتر</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>مشتری</th>
                    <th>کارشناس</th>
                    <th>امتیاز</th>
                    <th>عنوان</th>
                    <th>وضعیت</th>
                    <th>تاریخ</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Comments.Any())
                {
                    @foreach (var item in Model.Comments)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar avatar-sm me-2">
                                        <span class="avatar-initial rounded-circle bg-label-info">@item.CustomerName.Substring(0, 1)</span>
                                    </div>
                                    <div>@item.CustomerName</div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar avatar-sm me-2">
                                        <span class="avatar-initial rounded-circle bg-label-warning">@item.ExpertName.Substring(0, 1)</span>
                                    </div>
                                    <div>@item.ExpertName</div>
                                </div>
                            </td>
                            <td>
                                <div class="text-warning">
                                    @for (int i = 0; i < (int)item.Rating; i++)
                                    {
                                        <i class="ti ti-star-filled ti-xs"></i>
                                    }
                                </div>
                            </td>
                            <td>@item.Title</td>
                            <td>
                                @if (item.IsApproved)
                                {
                                    <span class="badge bg-label-success">تایید شده</span>
                                }
                                else
                                {
                                    <span class="badge bg-label-warning">در انتظار</span>
                                }
                            </td>
                            <td dir="ltr">@item.CreatedAt.ToShamsi()</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-icon btn-sm btn-info"
                                            data-bs-toggle="modal"
                                            data-bs-target="#viewCommentModal"
                                            data-title="@item.Title"
                                            data-text="@item.Text">
                                        <i class="ti ti-eye"></i>
                                    </button>

                                    @if (!item.IsApproved)
                                    {
                                        <form method="post" asp-page-handler="ChangeStatus" asp-route-id="@item.Id" asp-route-isApproved="true" class="d-inline">
                                            <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                            <input type="hidden" name="SearchKey" value="@Model.SearchKey" />
                                            <button type="button" class="btn btn-icon btn-sm btn-success confirm-action" data-msg="آیا این نظر را تایید می‌کنید؟">
                                                <i class="ti ti-check"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="ChangeStatus" asp-route-id="@item.Id" asp-route-isApproved="false" class="d-inline">
                                            <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                            <input type="hidden" name="SearchKey" value="@Model.SearchKey" />
                                            <button type="button" class="btn btn-icon btn-sm btn-warning confirm-action" data-msg="آیا تایید این نظر را لغو می‌کنید؟">
                                                <i class="ti ti-x"></i>
                                            </button>
                                        </form>
                                    }

                                    <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline">
                                        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                        <input type="hidden" name="SearchKey" value="@Model.SearchKey" />
                                        <button type="button" class="btn btn-icon btn-sm btn-danger confirm-delete">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-4">
                            <i class="ti ti-search fs-2 text-muted mb-2"></i>
                            <p>هیچ نظری یافت نشد.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer d-flex justify-content-center">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-page="./CommentManager" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-SearchKey="@Model.SearchKey">قبلی</a>
                </li>
                <li class="page-item active">
                    <span class="page-link">صفحه @Model.PageNumber</span>
                </li>
                <li class="page-item @(Model.Comments.Count < Model.PageSize ? "disabled" : "")">
                    <a class="page-link" asp-page="./CommentManager" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-SearchKey="@Model.SearchKey">بعدی</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<div class="modal fade" id="viewCommentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="commentModalTitle">عنوان نظر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="commentModalText" class="lead text-break"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<script>
    const modal = document.getElementById('viewCommentModal');
    modal.addEventListener('show.bs.modal', function (event) {
        const button = event.relatedTarget;
        const title = button.getAttribute('data-title');
        const text = button.getAttribute('data-text');

        modal.querySelector('#commentModalTitle').textContent = title;
        modal.querySelector('#commentModalText').textContent = text;
    });

    document.querySelectorAll('.confirm-action').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const form = this.closest('form');
            const msg = this.getAttribute('data-msg');

            Swal.fire({
                title: 'تغییر وضعیت',
                text: msg,
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'بله',
                cancelButtonText: 'خیر'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    });

    document.querySelectorAll('.confirm-delete').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const form = this.closest('form');

            Swal.fire({
                title: 'حذف نظر',
                text: 'آیا از حذف این نظر مطمئن هستید؟ این عملیات غیرقابل بازگشت است.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'بله، حذف کن',
                cancelButtonText: 'لغو',
                customClass: {
                    confirmButton: 'btn btn-danger me-3',
                    cancelButton: 'btn btn-label-secondary'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    });
</script>