@page
@model Servino.Presentation.RazorPagesUI.Areas.Admin.Pages.CommentManagerModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "مدیریت نظرات کاربران";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/datatables-bs5/datatables.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.dist.css">
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css">
}

@section VendorScripts {
    <script src="~/vendor/libs/datatables-bs5/datatables-bootstrap5.dist.js"></script>
    <script src="~/vendor/libs/datatables-bs5/i18n/fa.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">مدیریت محتوا /</span> نظرات کاربران
</h4>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>کل نظرات</span>
                        <h3 class="mb-0 me-2">1,284</h3>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-primary">
                            <i class="ti ti-message-circle ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>تایید شده</span>
                        <h3 class="mb-0 me-2 text-success">1,105</h3>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-success">
                            <i class="ti ti-check ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>در انتظار تأیید</span>
                        <h3 class="mb-0 me-2 text-warning">156</h3>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-warning">
                            <i class="ti ti-clock ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div class="content-left">
                        <span>امتیاز میانگین</span>
                        <h3 class="mb-0 me-2">4.6 <i class="ti ti-star-filled text-warning ti-xs"></i></h3>
                    </div>
                    <div class="avatar">
                        <span class="avatar-initial rounded bg-label-info">
                            <i class="ti ti-star ti-sm"></i>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="card-title mb-0">لیست نظرات کاربران</h5>
        <div class="btn-group">
            <button class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                <i class="ti ti-filter me-1"></i> فیلتر وضعیت
            </button>
            <ul class="dropdown-menu">
                <li><a class="dropdown-item" href="javascript:void(0);" data-filter="all">همه</a></li>
                <li><a class="dropdown-item" href="javascript:void(0);" data-filter="approved">تایید شده</a></li>
                <li><a class="dropdown-item" href="javascript:void(0);" data-filter="pending">در انتظار تأیید</a></li>
            </ul>
        </div>
    </div>

    <div class="card-datatable table-responsive">
        <table id="commentsTable" class="table table-hover">
            <thead class="table-light">
                <tr>
                    <th></th>
                    <th>مشتری</th>
                    <th>کارشناس</th>
                    <th>امتیاز</th>
                    <th>عنوان نظر</th>
                    <th>متن نظر (خلاصه)</th>
                    <th>درخواست</th>
                    <th>وضعیت</th>
                    <th>تاریخ</th>
                    <th>عملیات</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td></td>
                    <td>
                        <div class="d-flex align-items-center">
                            <img src="~/img/avatars/3.png" class="rounded-circle me-2" width="32" height="32" alt="مشتری">
                            <div>مهتاب کرامتی</div>
                        </div>
                    </td>
                    <td>
                        <div class="d-flex align-items-center">
                            <img src="~/img/avatars/7.png" class="rounded-circle me-2" width="32" height="32" alt="کارشناس">
                            <div>رضا احمدی</div>
                        </div>
                    </td>
                    <td>
                        <div class="d-flex">
                            <i class="ti ti-star-filled text-warning"></i>
                            <i class="ti ti-star-filled text-warning"></i>
                            <i class="ti ti-star-filled text-warning"></i>
                            <i class="ti ti-star-filled text-warning"></i>
                            <i class="ti ti-star-filled text-warning"></i>
                        </div>
                    </td>
                    <td>عالی بود!</td>
                    <td class="text-truncate" style="max-width: 200px;">
                        کار خیلی تمیز و سریع انجام شد. کارشناس بسیار مودب و حرفه‌ای بود...
                    </td>
                    <td>#R1024</td>
                    <td><span class="badge bg-label-success">تایید شده</span></td>
                    <td>۱۴۰۴/۰۹/۱۰</td>
                    <td>
                        <div class="d-flex gap-1">
                            <button class="btn btn-icon btn-sm btn-info" title="مشاهده متن کامل"
                                    data-bs-toggle="modal" data-bs-target="#viewCommentModal"
                                    data-title="عالی بود!" data-text="کار خیلی تمیز و سریع انجام شد. کارشناس بسیار مودب و حرفه‌ای بود. حتماً دوباره از خدماتش استفاده می‌کنم.">
                                <i class="ti ti-eye"></i>
                            </button>
                            <button class="btn btn-icon btn-sm btn-success" title="تایید نظر"
                                    onclick="approveComment(45, true)">
                                <i class="ti ti-check"></i>
                            </button>
                            <button class="btn btn-icon btn-sm btn-danger" title="رد نظر"
                                    onclick="approveComment(45, false)">
                                <i class="ti ti-x"></i>
                            </button>
                            <button class="btn btn-icon btn-sm btn-outline-danger" title="حذف"
                                    onclick="confirmCommentDelete(45)">
                                <i class="ti ti-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>

                <tr>
                    <td></td>
                    <td><!-- مشتری --></td>
                    <td><!-- کارشناس --></td>
                    <td>
                        <div class="d-flex">
                            <i class="ti ti-star-filled text-warning"></i>
                            <i class="ti ti-star-filled text-warning"></i>
                            <i class="ti ti-star-filled text-warning"></i>
                            <i class="ti ti-star text-muted"></i>
                            <i class="ti ti-star text-muted"></i>
                        </div>
                    </td>
                    <td>متوسط بود</td>
                    <td class="text-truncate" style="max-width: 200px;">کار قابل قبول بود ولی کمی تأخیر داشت...</td>
                    <td>#R987</td>
                    <td><span class="badge bg-label-warning">در انتظار تأیید</span></td>
                    <td>۱۴۰۴/۰۹/۱۵</td>
                    <td><!-- همان دکمه‌ها --></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="viewCommentModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="commentModalTitle">عنوان نظر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="commentModalText" class="lead"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('[data-bs-target="#viewCommentModal"]').forEach(btn => {
        btn.addEventListener('click', function () {
            const title = this.getAttribute('data-title');
            const text = this.getAttribute('data-text');
            document.getElementById('commentModalTitle').textContent = title;
            document.getElementById('commentModalText').textContent = text;
        });
    });

    function approveComment(id, approve) {
        const action = approve ? 'تایید' : 'رد';
        Swal.fire({
            title: `آیا نظر را ${action} می‌کنید؟`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: `بله، ${action} کن`,
            cancelButtonText: 'خیر'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire(`${action} شد!`, `نظر با موفقیت ${action} گردید.`, 'success');
            }
        });
    }

    function confirmCommentDelete(id) {
        Swal.fire({
            title: 'آیا از حذف مطمئن هستید؟',
            text: 'این نظر برای همیشه حذف خواهد شد!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'بله، حذف کن',
            cancelButtonText: 'لغو'
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire('حذف شد!', 'نظر با موفقیت حذف گردید.', 'success');
            }
        });
    }

    $(document).ready(function () {
        const table = $('#commentsTable').DataTable({
            language: { url: '/vendor/libs/datatables-bs5/i18n/fa.dist.js' },
            responsive: true,
            order: [[8, 'desc']],
            columnDefs: [
                { orderable: false, targets: [0, 9] },
                { className: "text-center", targets: [3, 7] }
            ]
        });

        $('[data-filter]').on('click', function () {
            const filter = $(this).data('filter');
            if (filter === 'all') {
                table.column(7).search('').draw();
            } else if (filter === 'approved') {
                table.column(7).search('تایید شده').draw();
            } else if (filter === 'pending') {
                table.column(7).search('در انتظار تأیید').draw();
            }
        });
    });
</script>