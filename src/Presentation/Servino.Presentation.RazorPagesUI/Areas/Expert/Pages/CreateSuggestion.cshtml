@page
@model Servino.Presentation.RazorPagesUI.Areas.Expert.Pages.CreateSuggestionModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "ارسال پیشنهاد";
}
@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/jquery/jquery.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave.dist.js"></script>
    <script src="~/vendor/libs/cleavejs/cleave-phone.dist.js"></script>
    <script src="~/vendor/libs/moment/moment.dist.js"></script>
    <script src="~/vendor/libs/jdate/jdate.min.dist.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr-jdate.dist.js"></script>
    <script src="~/vendor/libs/flatpickr/l10n/fa.dist.js"></script>
    <script src="~/vendor/libs/select2/select2.dist.js"></script>
    <script src="~/vendor/libs/select2/i18n/fa.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
}



<h4 class="mb-4">ارسال پیشنهاد</h4>


<div asp-validation-summary="All"
     class="alert alert-danger mb-3"></div>

<form method="post" class="card">
    <input type="hidden" asp-for="Command.RequestId" />
    <div class="card-body">
        <div class="mb-3">
            <label class="form-label">مبلغ پیشنهادی (تومان)</label>
            <input asp-for="Command.SuggestedPrice" class="form-control"/>
        </div>

        <div class="mb-3">
            <label class="form-label">تاریخ پیشنهادی انجام</label>
            <input asp-for="SuggestedDate"
                   type="text"
                   class="form-control dob-picker"
                   placeholder="انتخاب تاریخ" />
        </div>


        <div class="mb-3">
            <label class="form-label">مدت زمان (ساعت)</label>
            <input asp-for="Command.EstimatedDurationHours" class="form-control"/>
        </div>

        <div class="mb-3">
            <label class="form-label">توضیحات</label>
            <textarea asp-for="Command.Note" class="form-control"></textarea>
        </div>

        <button class="btn btn-success">
            <i class="ti ti-check"></i>
            ثبت پیشنهاد
        </button>
    </div>
</form>

@section PageScripts {
    <script>
    $(document).ready(function () {

        if ($('.dob-picker').length) {
            $('.dob-picker').flatpickr({
                locale: 'fa',
                altInput: true,
                altFormat: 'Y/m/d',
                dateFormat: 'Y-m-d',
                calendarType: 'jalali',
                disableMobile: true
            });
        }

    });
</script>
}
