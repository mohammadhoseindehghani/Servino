@page
@using Servino.Framework.Extensions
@model Servino.Presentation.RazorPagesUI.Areas.Expert.Pages.RequestDetailsModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "جرئیات درخواست";
}
@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/sweetalert2/sweetalert2.dist.css" />
}
@section VendorScripts {
    <script src="~/vendor/libs/select2/select2.dist.js"></script>
    <script src="~/vendor/libs/select2/i18n/fa.dist.js"></script>
    <script src="~/vendor/libs/sweetalert2/sweetalert2.dist.js"></script>
}


<h4 class="mb-4">جزئیات درخواست</h4>

<div class="card">
    <div class="card-body">
        <h5>@Model.Request.Title</h5>
        <p class="text-muted">@Model.Request.Description</p>

        <ul class="list-unstyled mt-3">
            <li><strong>نام مشتری:</strong> @Model.Request.CustomerName</li>
            <li><strong>سرویس:</strong> @Model.Request.Title</li>
            <li><strong>شهر:</strong> @Model.Request.CityName</li>
            <li><strong>آدرس:</strong> @Model.Request.Address</li>
            <li><strong>توضیحات:</strong> @Model.Request.Description</li>
            <li>
                <strong>تصاویر:</strong>

                @if (Model.Request.ImagePaths != null && Model.Request.ImagePaths.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @foreach (var imagePath in Model.Request.ImagePaths)
                        {
                            <img src="@imagePath"
                                 alt="تصویر درخواست"
                                 class="img-thumbnail"
                                 style="width:120px;height:120px;object-fit:cover;cursor:pointer"
                                 onclick="window.open('@imagePath','_blank')" />
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted">تصویری ثبت نشده است</span>
                }
            </li>
            <li><strong>تاریخ مورد نیاز:</strong> @Model.Request.DateRequired.ToShamsi()</li>
        </ul>

        <a asp-page="./CreateSuggestion"
           asp-route-requestId="@Model.Request.Id"
           class="btn btn-primary mt-3">
            ارسال پیشنهاد
        </a>
    </div>
</div>
