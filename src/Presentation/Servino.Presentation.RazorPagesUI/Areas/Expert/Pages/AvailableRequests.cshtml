@page
@model Servino.Presentation.RazorPagesUI.Areas.Expert.Pages.AvailableRequestsModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "درخواست‌های موجود";
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">کارتابل /</span> فرصت‌های شغلی جدید
</h4>

<div class="row g-4">
    @if (Model.Requests.Any())
    {
        @foreach (var item in Model.Requests)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 text-truncate" title="@item.Title">@item.Title</h5>
                        <small class="text-muted">@item.DateRequired</small>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge bg-label-primary p-2 me-2">
                                <i class="ti ti-tool"></i>
                            </span>
                            <div>
                                <h6 class="mb-0">@item.ServiceName</h6>
                                <small class="text-muted">@item.CityName</small>
                            </div>
                        </div>

                        <p class="mb-4 text-muted small">
                            تعداد پیشنهادات فعلی: <span class="fw-bold text-dark">@item.SuggestionCount</span>
                        </p>

                        <div class="d-grid gap-2">
                            <a asp-page="./RequestDetails" asp-route-id="@item.Id" class="btn btn-primary">
                                <i class="ti ti-eye me-1"></i> مشاهده و ثبت پیشنهاد
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info d-flex align-items-center" role="alert">
                <i class="ti ti-info-circle me-2"></i>
                <div>
                    در حال حاضر سفارش جدیدی متناسب با مهارت‌ها و شهر شما موجود نیست.
                </div>
            </div>
        </div>
    }
</div>