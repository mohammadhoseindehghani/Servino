@page
@using Servino.Framework.Extensions
@model Servino.Presentation.RazorPagesUI.Areas.Expert.Pages.AvailableRequestsModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "درخواست‌های موجود";
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">کارتابل /</span> فرصت‌های شغلی جدید
</h4>

<div class="row g-4">
    @if (Model.Requests.Any())
    {
        @foreach (var item in Model.Requests)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 text-truncate" title="@item.Title">@item.Title</h5>
                        <span class="badge bg-label-secondary">@item.DateRequired.ToShamsi()</span>
                    </div>

                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge bg-label-primary p-2 me-2">
                                <i class="ti ti-tool"></i>
                            </span>
                            <div>
                                <h6 class="mb-0">@item.ServiceName</h6>
                                <small class="text-muted">@item.CityName</small>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-page="./RequestDetails"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="ti ti-info-circle me-1"></i>
                                جزئیات درخواست
                            </a>

                            @if (!item.HasExpertSuggestion)
                            {
                                <a asp-page="./CreateSuggestion"
                                   asp-route-requestId="@item.Id"
                                   class="btn btn-primary btn-sm">
                                    <i class="ti ti-send me-1"></i>
                                    ارسال پیشنهاد
                                </a>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-success btn-sm"
                                        onclick="openSuggestionModal(@item.ExpertSuggestionId)">
                                    <i class="ti ti-eye me-1"></i>
                                    مشاهده پیشنهاد من
                                </button>


                            }
                        </div>
                    </div>
                </div>
            </div>

        }
    }
    else
    {
        <div class="col-12">
            <div class="alert alert-info d-flex align-items-center" role="alert">
                <i class="ti ti-info-circle me-2"></i>
                <div>
                    در حال حاضر سفارش جدیدی متناسب با مهارت‌ها و شهر شما موجود نیست.
                </div>
            </div>
        </div>
    }
</div>

<!-- Suggestion Details Modal -->
<div class="modal fade" id="suggestionModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">جزئیات پیشنهاد من</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="suggestionModalBody"></div>
        </div>
    </div>
</div>


            
@section PageScripts {
    <script>
    function openSuggestionModal(id) {
        const modal = new bootstrap.Modal(document.getElementById('suggestionModal'));
        const body = document.getElementById('suggestionModalBody');

        body.innerHTML = `
            <div class="text-center text-muted">
                <div class="spinner-border spinner-border-sm me-2"></div>
                در حال بارگذاری...
            </div>`;

        fetch(`?handler=SuggestionDetails&id=${id}`)
            .then(r => r.json())
            .then(data => {
                if (!data) {
                    body.innerHTML = '<div class="alert alert-warning">اطلاعاتی یافت نشد</div>';
                    return;
                }

                body.innerHTML = `
                    <div class="row">
                        <div class="col-6">
                            <strong>مبلغ پیشنهادی:</strong>
                            ${data.price.toLocaleString()} تومان
                        </div>
                        <div class="col-6">
                            <strong>مدت انجام:</strong>
                            ${data.duration} روز
                        </div>
                        <div class="col-12 mt-3">
                            <strong>توضیحات:</strong>
                            <p class="text-muted">${data.description}</p>
                        </div>
                        <div class="col-12 text-end text-muted small">
                            ثبت شده در ${data.createdAt}
                        </div>
                    </div>`;
            })
            .catch(() => {
                body.innerHTML = '<div class="alert alert-danger">خطا در دریافت اطلاعات</div>';
            });

        modal.show();
    }
</script>
}
