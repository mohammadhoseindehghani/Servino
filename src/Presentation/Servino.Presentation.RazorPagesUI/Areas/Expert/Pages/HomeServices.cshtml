@page
@model Servino.Presentation.RazorPagesUI.Areas.Expert.Pages.HomeServicesModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "مدیریت خدمات";
}

@if (!string.IsNullOrEmpty(Model.MessageText))
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Swal.fire({
                title: '@(Model.MessageType == "success" ? "موفق!" : "خطا!")',
                text: '@Html.Raw(Model.MessageText)',
                icon: '@(Model.MessageType == "success" ? "success" : "error")',
                confirmButtonText: 'باشه'
            }).then(() => {
                const url = new URL(window.location);
                url.searchParams.delete('msg');
                url.searchParams.delete('text');
                window.history.replaceState({}, '', url);
            });
        });
    </script>
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">تنظیمات /</span> خدمات من
</h4>

<div class="row">
    <div class="col-md-12">
        <ul class="nav nav-pills flex-column flex-md-row mb-4">
            <li class="nav-item"><a class="nav-link" asp-page="./Profile"><i class="ti-xs ti ti-user me-1"></i> مشخصات فردی</a></li>
            <li class="nav-item"><a class="nav-link active" href="javascript:void(0);"><i class="ti-xs ti ti-tools me-1"></i> خدمات من</a></li>
        </ul>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">انتخاب مهارت‌ها و خدمات</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    @Html.AntiForgeryToken()
                    @if (Model.ServiceItems != null && Model.ServiceItems.Any())
                    {
                        <div class="row">
                            @foreach (var service in Model.ServiceItems)
                            {
                                <div class="col-md-4 col-sm-6 mb-3">
                                    <div class="form-check custom-option custom-option-basic">
                                        <label class="form-check-label custom-option-content" for="srv_@service.HomeServiceId">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="SelectedServiceIds"
                                                   value="@service.HomeServiceId"
                                                   id="srv_@service.HomeServiceId"
                                                   @(service.IsSelected ? "checked" : "")/>
                                            <span class="custom-option-header">
                                                <span class="h6 mb-0">@service.HomeServiceTitle</span>
                                            </span>
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary me-2">ذخیره تغییرات</button>
                            <a asp-page="./Profile" class="btn btn-label-secondary">بازگشت</a>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">هیچ خدمتی در سیستم تعریف نشده است.</div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>