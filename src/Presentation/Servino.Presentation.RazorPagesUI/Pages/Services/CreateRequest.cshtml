@page "{serviceId:int}"
@model Servino.Presentation.RazorPagesUI.Pages.Services.CreateRequestModel
@{
    Layout = "Layouts/_FrontLayout";
    ViewData["Title"] = "ثبت سفارش جدید";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/select2/select2.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/flatpickr/flatpickr.dist.css" />
}

@section VendorScripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="~/vendor/libs/select2/select2.dist.js"></script>
    <script src="~/vendor/libs/select2/i18n/fa.dist.js"></script>
    <script src="~/vendor/libs/flatpickr/flatpickr.dist.js"></script>
    @* برای تاریخ شمسی فلت‌پیکر *@
    @* <script src="https://npmcdn.com/flatpickr/dist/l10n/fa.js"></script> *@ 
}

<section class="section-py bg-body first-section-offset">
    <div class="container">

        <div class="row g-4 justify-content-center">
            <div class="col-md-4 order-md-2">
                <div class="card border border-primary shadow-none">
                    <div class="card-body text-center">
                        <div class="avatar avatar-xl mb-3 bg-label-primary rounded p-2 mx-auto">
                            @if (!string.IsNullOrEmpty(Model.ServiceImage))
                            {
                                <img src="@Model.ServiceImage" alt="@Model.ServiceTitle" class="img-fluid" />
                            }
                            else
                            {
                                <i class="ti ti-tool fs-2"></i>
                            }
                        </div>
                        <h5 class="mb-1">@Model.ServiceTitle</h5>
                        <p class="text-muted mb-3">شروع قیمت از: <span class="fw-bold text-primary">@Model.BasePrice.ToString("N0")</span> تومان</p>

                        <div class="alert alert-warning mb-0 text-start small">
                            <i class="ti ti-info-circle me-1"></i>
                            قیمت نهایی پس از بازدید متخصص و توافق طرفین تعیین می‌شود. این مبلغ صرفاً پایه است.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8 order-md-1">
                <div class="card mb-4">
                    <h5 class="card-header">جزئیات سفارش</h5>
                    <div class="card-body">

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                        }

                        <form method="post" enctype="multipart/form-data">
                            <input type="hidden" asp-for="Input.HomeServiceId" />

                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label" asp-for="Input.Title">عنوان درخواست <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" asp-for="Input.Title" placeholder="مثال: نظافت کلی منزل مسکونی" autofocus />
                                    <span asp-validation-for="Input.Title" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" asp-for="Input.ProvinceId">استان <span class="text-danger">*</span></label>
                                    <select class="form-select select2" asp-for="Input.ProvinceId" id="provinceSelect">
                                        <option value="">انتخاب استان...</option>
                                        @foreach (var p in Model.Provinces)
                                        {
                                            <option value="@p.Id">@p.Title</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Input.ProvinceId" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" asp-for="Input.CityId">شهر <span class="text-danger">*</span></label>
                                    <select class="form-select select2" asp-for="Input.CityId" id="citySelect" disabled>
                                        <option value="">ابتدا استان را انتخاب کنید</option>
                                    </select>
                                    <span asp-validation-for="Input.CityId" class="text-danger"></span>
                                </div>

                                <div class="col-12">
                                    <label class="form-label" asp-for="Input.Address">آدرس دقیق <span class="text-danger">*</span></label>
                                    <textarea class="form-control" asp-for="Input.Address" rows="2" placeholder="خیابان، کوچه، پلاک، واحد..."></textarea>
                                    <span asp-validation-for="Input.Address" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" asp-for="Input.DateRequired">تاریخ مورد نیاز <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" asp-for="Input.DateRequired" />
                                    <span asp-validation-for="Input.DateRequired" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">افزودن تصویر (اختیاری)</label>
                                    <input type="file" class="form-control" asp-for="Input.Images" multiple accept="image/png, image/jpeg" />
                                    <div class="form-text">حداکثر ۵ تصویر (JPG, PNG)</div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label" asp-for="Input.Description">توضیحات تکمیلی <span class="text-danger">*</span></label>
                                    <textarea class="form-control" asp-for="Input.Description" rows="4" placeholder="توضیحات کامل در مورد کار، متراژ، خرابی و..."></textarea>
                                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                                </div>

                                <div class="col-12 mt-4">
                                    <button type="submit" class="btn btn-primary w-100 btn-lg">ثبت نهایی سفارش</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section PageScripts {
    <script>
        $(document).ready(function () {
            $('.select2').select2({
                dir: "rtl",
                width: '100%',
                placeholder: "انتخاب کنید..."
            });

            $('#provinceSelect').on('change', function () {
                var provinceId = $(this).val();
                var $citySelect = $('#citySelect');

                console.log("استان تغییر کرد. شناسه:", provinceId); 

                $citySelect.empty().append('<option value="">در حال بارگذاری...</option>');
                $citySelect.prop('disabled', true);

                $citySelect.trigger('change.select2');

                if (provinceId) {
                    $.ajax({
                        type: "GET",
                        url: "@Url.Page("", "GetCities")",
                        data: { provinceId: provinceId },
                        success: function (data) {
                            console.log("شهرهای دریافتی:", data); 

                            $citySelect.empty();
                            $citySelect.append('<option value="">انتخاب شهر...</option>');

                            $.each(data, function (index, item) {
                                var option = new Option(item.title, item.id, false, false);
                                $citySelect.append(option);
                            });

                            $citySelect.prop('disabled', false);
                            $citySelect.trigger('change.select2');
                        },
                        error: function (xhr, status, error) {
                            console.error("خطا:", xhr.responseText);
                            alert("خطا در دریافت لیست شهرها. لطفاً کنسول مرورگر را چک کنید.");

                            $citySelect.empty().append('<option value="">خطا در بارگذاری</option>');
                            $citySelect.trigger('change.select2');
                        }
                    });
                } else {
                    $citySelect.empty().append('<option value="">ابتدا استان را انتخاب کنید</option>');
                    $citySelect.prop('disabled', true);
                    $citySelect.trigger('change.select2');
                }
            });
        });
    </script>
}