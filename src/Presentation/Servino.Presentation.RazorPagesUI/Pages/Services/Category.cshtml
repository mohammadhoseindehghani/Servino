@page "{id:int}"
@model Servino.Presentation.RazorPagesUI.Pages.Services.CategoryModel
@{
    Layout = "Layouts/_FrontLayout";
}

@section VendorStyles {
    <style>
        .hover-lift {
            transition: transform 0.2s;
        }

            .hover-lift:hover {
                transform: translateY(-5px);
                box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
            }

        .breadcrumb-item + .breadcrumb-item::before {
            float: right;
            padding-left: .5rem;
            padding-right: 0;
        }
    </style>
}

<section class="section-py bg-body first-section-offset">
    <div class="container">

        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb breadcrumb-style1">
                <li class="breadcrumb-item">
                    <a href="/">
                        <i class="ti ti-home me-1"></i> خانه
                    </a>
                </li>
                @if (Model.Breadcrumbs != null!)
                {
                    @foreach (var item in Model.Breadcrumbs)
                    {
                        var isLast = item == Model.Breadcrumbs.Last();
                        <li class="breadcrumb-item @(isLast ? "active" : "")">
                            @if (isLast)
                            {
                                @item.Title
                            }
                            else
                            {
                                <a href="/Services/Category/@item.Id">@item.Title</a>
                            }
                        </li>
                    }
                }
            </ol>
        </nav>

        <div class="text-center mb-5">
            <h3 class="mb-2">@Model.CurrentTitle</h3>
            <p class="text-muted">
                @(Model.IsServiceMode ? "سرویس مورد نظر خود را انتخاب کنید" : "لطفاً زیرمجموعه مورد نظر را انتخاب کنید")
            </p>
        </div>

        <div class="row g-4">

            @if (!Model.IsServiceMode)
            {
                @foreach (var item in Model.SubCategories)
                {
                    <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                        <a href="/Services/Category/@item.Id" class="card h-100 text-center text-decoration-none hover-lift border">
                            <div class="card-body p-3">
                                <div class="avatar avatar-xl mb-3 bg-label-primary rounded p-2 mx-auto">
                                    @if (!string.IsNullOrEmpty(item.ImagePath))
                                    {
                                        <img src="@item.ImagePath" alt="@item.Title" class="img-fluid" />
                                    }
                                    else
                                    {
                                        <i class="ti ti-folder fs-2"></i>
                                    }
                                </div>
                                <h6 class="mb-0 text-heading small fw-bold">@item.Title</h6>
                                @if (item.HasChildren)
                                {
                                    <span class="d-block mt-2 text-muted" style="font-size: 0.7rem">
                                        <i class="ti ti-chevron-left"></i> زیرمجموعه دارد
                                    </span>
                                }
                            </div>
                        </a>
                    </div>
                }
            }

            else
            {
                @if (Model.Services.Any())
                {
                    @foreach (var service in Model.Services)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 hover-lift border-primary border-opacity-25">
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="avatar avatar-md me-3 bg-label-success rounded p-1">
                                            @if (!string.IsNullOrEmpty(service.ImagePath))
                                            {
                                                <img src="@service.ImagePath" class="img-fluid rounded" />
                                            }
                                            else
                                            {
                                                <i class="ti ti-tool fs-4"></i>
                                            }
                                        </div>
                                        <div>
                                            <h5 class="mb-0">@service.Title</h5>
                                            <span class="text-primary fw-bold small">
                                                شروع قیمت از: @service.BasePrice.ToString("N0") تومان
                                            </span>
                                        </div>
                                    </div>
                                    <p class="text-muted small mb-3">
                                        @(service.ShortDescription ?? "توضیحات تکمیلی برای این سرویس ثبت نشده است.")
                                    </p>
                                    <div class="d-grid">
                                        <a href="/Services/CreateRequest/@service.Id" class="btn btn-outline-primary btn-sm">
                                            ثبت سفارش آنلاین
                                            <i class="ti ti-arrow-left ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <div class="alert alert-warning text-center">
                            <i class="ti ti-alert-circle me-2"></i>
                            هنوز سرویسی برای این دسته تعریف نشده است.
                        </div>
                    </div>
                }
            }

        </div>
    </div>
</section>