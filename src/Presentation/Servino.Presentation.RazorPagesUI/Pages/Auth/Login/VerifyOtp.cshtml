@page
@model Servino.Presentation.RazorPagesUI.Pages.Auth.Login.VerifyOtpModel
@{
    Layout = "Layouts/_BlankLayout";
    ViewData["Title"] = "تایید شماره موبایل";
}
@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/page-auth.dist.css">
}

<div class="authentication-wrapper authentication-cover authentication-bg">
    <div class="authentication-inner row">
        <div class="d-none d-lg-flex col-lg-7 p-0">
            <div class="auth-cover-bg auth-cover-bg-color d-flex justify-content-center align-items-center">
                <img src="~/img/illustrations/auth-two-step-illustration-light.png" class="img-fluid my-5 auth-illustration">
            </div>
        </div>

        <div class="d-flex col-12 col-lg-5 align-items-center p-sm-5 p-4">
            <div class="w-px-400 mx-auto">
                <h4 class="mb-1">تایید شماره موبایل 💬</h4>
                <p class="mb-4">کد ارسال شده به <strong dir="ltr">@Model.Mobile</strong> را وارد کنید.</p>

                <form method="POST">
                    <input type="hidden" asp-for="Mobile" />
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label">کد تایید</label>
                        <input type="text" asp-for="Input.Code" class="form-control text-center fs-4" maxlength="5" autofocus />
                    </div>

                    <button class="btn btn-primary d-grid w-100" type="submit">تایید و ورود</button>
                </form>

                <div class="text-center mt-3">
                    <a href="/Auth/Login">بازگشت به ورود</a>
                </div>
            </div>
        </div>
    </div>
</div>