@page
@model Servino.Presentation.RazorPagesUI.Pages.IndexModel
@{
    Layout = "Layouts/_FrontLayout";
    ViewData["Title"] = "سروینو - درخواست آنلاین خدمات منزل و محل کار";
}

@section VendorStyles {
    <link rel="stylesheet" href="~/vendor/libs/nouislider/nouislider.dist.css" />
    <link rel="stylesheet" href="~/vendor/libs/swiper/swiper.dist.css" />
    <style>
        /* استایل اختصاصی برای هاور کارت‌های دسته‌بندی */
        .category-card {
            transition: all 0.3s ease-in-out;
        }
        .category-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
            border-color: var(--bs-primary) !important;
        }
        .hero-search-box {
            max-width: 650px;
            margin: 0 auto;
        }
    </style>
}

@section PageStyles {
    <link rel="stylesheet" href="~/vendor/css/pages/front-page-landing.dist.css" />
}

@section VendorScripts {
    <script src="~/vendor/libs/nouislider/nouislider.dist.js"></script>
    <script src="~/vendor/libs/swiper/swiper.dist.js"></script>
}

@section PageScripts {
    <script src="~/js/front-page-landing.dist.js"></script>
}

@* ************** Content ************** *@
<div data-bs-spy="scroll" class="scrollspy-example">

    <section id="hero-animation">
        <div id="landingHero" class="section-py landing-hero position-relative">
            <div class="container">
                <div class="hero-text-box text-center">
                    <h1 class="text-primary hero-title display-6 fw-bold">
                        آسایش شما، تخصص ماست
                    </h1>
                    <h2 class="hero-sub-title h6 mb-4 mt-2 pb-1 lh-2">
                        دسترسی سریع به هزاران متخصص احراز هویت شده
                        <br class="d-none d-lg-block" />
                        از نظافت و پذیرایی تا تعمیرات و دکوراسیون در محل شما
                    </h2>

                    <div class="hero-search-box position-relative w-100 mt-4">
                        <form action="/Services/Search" method="get">
                            <div class="input-group input-group-lg input-group-merge shadow-lg rounded-pill bg-body p-1">
                                <span class="input-group-text border-0 ps-4 rounded-pill text-muted bg-transparent">
                                    <i class="ti ti-search"></i>
                                </span>
                                <input type="text" name="q" class="form-control border-0 bg-transparent" placeholder="چه خدمتی نیاز دارید؟ (مثلا: نظافت، تعمیر کولر...)" aria-label="Search">
                                <button class="btn btn-primary rounded-pill px-4 m-1" type="submit">جستجو</button>
                            </div>
                        </form>
                        <div class="mt-3 text-muted small">
                            خدمات پرطرفدار:
                            <span class="badge bg-label-secondary cursor-pointer me-1">نظافت منزل</span>
                            <span class="badge bg-label-secondary cursor-pointer me-1">کارواش سیار</span>
                            <span class="badge bg-label-secondary cursor-pointer">لوله کشی</span>
                        </div>
                    </div>
                </div>

                <div id="heroDashboardAnimation" class="hero-animation-img">
                    <a href="#" target="_blank">
                        <div id="heroAnimationImg" class="position-relative hero-dashboard-img">
                            <img src="~/img/front-pages/landing-page/hero-dashboard-light.png" alt="hero dashboard" class="animation-img" data-app-light-img="front-pages/landing-page/hero-dashboard-light.png" data-app-dark-img="front-pages/landing-page/hero-dashboard-dark.png" />
                            <img src="~/img/front-pages/landing-page/hero-elements-light.png" alt="hero elements" class="position-absolute hero-elements-img animation-img top-0 start-0" data-app-light-img="front-pages/landing-page/hero-elements-light.png" data-app-dark-img="front-pages/landing-page/hero-elements-dark.png" />
                        </div>
                    </a>
                </div>
            </div>
        </div>
        <div class="landing-hero-blank"></div>
    </section>
    <section id="landingCategories" class="section-py bg-body landing-categories">
        <div class="container">
            <div class="text-center mb-3 pb-1">
                <span class="badge bg-label-primary">دسته‌بندی‌ها</span>
            </div>
            <h3 class="text-center mb-1 fw-bold">
                <span class="section-title">خدمات اصلی</span> سروینو
            </h3>
            <p class="text-center mb-5 pb-3">برای مشاهده خدمات، دسته‌بندی مورد نظر را انتخاب کنید</p>

            <div class="row g-4 justify-content-center">
                @if (Model.Categories != null && Model.Categories.Any())
                {
                    @foreach (var item in Model.Categories.Where(c => c.ParentId == null && c.IsActive))
                    {
                        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
                            <a href="/Services/Category/@item.Id" class="card h-100 shadow-sm border text-center text-decoration-none category-card bg-body">
                                <div class="card-body d-flex flex-column align-items-center justify-content-center p-3">
                                    <div class="avatar avatar-xl mb-3 bg-label-primary rounded p-2">
                                        @if (!string.IsNullOrEmpty(item.ImagePath))
                                        {
                                            <img src="@item.ImagePath" alt="@item.Title" class="img-fluid" />
                                        }
                                        else
                                        {
                                            <i class="ti ti-smart-home fs-2"></i>
                                        }
                                    </div>
                                    <h6 class="mb-0 text-heading small fw-bold">@item.Title</h6>
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center">
                        <div class="alert alert-warning">دسته بندی‌ها بارگذاری نشده‌اند.</div>
                    </div>
                }
            </div>
        </div>
    </section>
    <section id="landingFeatures" class="section-py landing-features">
        <div class="container">
            <div class="text-center mb-3 pb-1">
                <span class="badge bg-label-primary">چرا سروینو؟</span>
            </div>
            <h3 class="text-center mb-1 fw-medium">
                <span class="section-title">ویژگی‌های متمایز</span> ما
            </h3>
            <p class="text-center mb-3 mb-md-5 pb-3"> خیال راحت، قیمت مناسب و کیفیت تضمین شده.</p>
            <div class="features-icon-wrapper row gx-0 gy-4 g-sm-5">
                <div class="col-lg-4 col-sm-6 text-center features-icon-box">
                    <div class="text-center mb-3">
                        <img src="~/img/front-pages/icons/user.png" alt="laptop charging" />
                    </div>
                    <h5 class="mb-2">متخصصین احراز هویت شده</h5>
                    <p class="features-icon-description">تمامی متخصصین از فیلترهای تایید صلاحیت و گواهی عدم سوء پیشینه عبور کرده‌اند.</p>
                </div>
                <div class="col-lg-4 col-sm-6 text-center features-icon-box">
                    <div class="text-center mb-3">
                        <img src="~/img/front-pages/icons/check.png" alt="transition up" />
                    </div>
                    <h5 class="mb-2">بیمه تمام خدمات</h5>
                    <p class="features-icon-description">تمام خدمات ارائه شده تحت پوشش بیمه حوادث قرار دارند تا نگران چیزی نباشید.</p>
                </div>
                <div class="col-lg-4 col-sm-6 text-center features-icon-box">
                    <div class="text-center mb-3">
                        <img src="~/img/front-pages/icons/paper.png" alt="edit" />
                    </div>
                    <h5 class="mb-2">قیمت‌گذاری شفاف</h5>
                    <p class="features-icon-description">مشاهده قیمت قبل از ثبت سفارش و عدم دریافت هزینه اضافی در محل.</p>
                </div>
                <div class="col-lg-4 col-sm-6 text-center features-icon-box">
                    <div class="text-center mb-3">
                        <img src="~/img/front-pages/icons/rocket.png" alt="3d select solid" />
                    </div>
                    <h5 class="mb-2">سرعت در اعزام</h5>
                    <p class="features-icon-description">اعزام متخصص در کمترین زمان ممکن متناسب با زمان انتخابی شما.</p>
                </div>
                <div class="col-lg-4 col-sm-6 text-center features-icon-box">
                    <div class="text-center mb-3">
                        <img src="~/img/front-pages/icons/user.png" alt="lifebelt" />
                    </div>
                    <h5 class="mb-2">پشتیبانی ۱۲ ساعته</h5>
                    <p class="features-icon-description">تیم پشتیبانی از ۸ صبح تا ۱۲ شب در تمام روزهای هفته پاسخگوی شماست.</p>
                </div>
                <div class="col-lg-4 col-sm-6 text-center features-icon-box">
                    <div class="text-center mb-3">
                        <img src="~/img/front-pages/icons/keyboard.png" alt="google docs" />
                    </div>
                    <h5 class="mb-2">تنوع خدمات</h5>
                    <p class="features-icon-description">بیش از ۲۰۰ خدمت متنوع برای تمامی نیازهای منزل و محل کار شما.</p>
                </div>
            </div>
        </div>
    </section>
    <section id="landingReviews" class="section-py bg-body landing-reviews pb-0">
        <div class="container">
            <div class="row align-items-center gx-0 gy-4 g-lg-5">
                <div class="col-md-6 col-lg-5 col-xl-3">
                    <div class="mb-3 pb-1">
                        <span class="badge bg-label-primary">نظرات مشتریان</span>
                    </div>
                    <h3 class="mb-2">
                        <span class="position-relative fw-bold z-1 section-title">
                            تجربه کاربران ما
                        </span>
                    </h3>
                    <p class="mb-3 mb-md-5">
                        ببینید دیگران درباره کیفیت خدمات
                        <br class="d-none d-xl-block" />
                        سروینو چه می‌گویند.
                    </p>
                    <div class="landing-reviews-btns">
                        <button id="reviews-previous-btn" class="btn btn-label-primary reviews-btn me-3 scaleX-n1-rtl" type="button">
                            <i class="ti ti-chevron-left ti-sm"></i>
                        </button>
                        <button id="reviews-next-btn" class="btn btn-label-primary reviews-btn scaleX-n1-rtl" type="button">
                            <i class="ti ti-chevron-right ti-sm"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-6 col-lg-7 col-xl-9">
                    <div class="swiper-reviews-carousel overflow-hidden mb-5 pb-md-2 pb-md-3">
                        <div class="swiper" id="swiper-reviews">
                            <div class="swiper-wrapper">
                                <div class="swiper-slide">
                                    <div class="card h-100">
                                        <div class="card-body text-body d-flex flex-column justify-content-between h-100">
                                            <div class="mb-3">
                                                <span class="badge bg-label-success">نظافت منزل</span>
                                            </div>
                                            <p class="justify-text">نیروی اعزامی بسیار مودب و کاربلد بود. تمام کارها رو با دقت انجام دادن و سر ساعت هم رسیدن. واقعا راضی بودم.</p>
                                            <div class="text-warning mb-3">
                                                <i class="ti ti-star-filled ti-sm"></i><i class="ti ti-star-filled ti-sm"></i><i class="ti ti-star-filled ti-sm"></i><i class="ti ti-star-filled ti-sm"></i><i class="ti ti-star-filled ti-sm"></i>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar me-2 avatar-sm">
                                                    <img src="~/img/avatars/1.png" alt="Avatar" class="rounded-circle" />
                                                </div>
                                                <div>
                                                    <h6 class="mb-0">سارا محمدی</h6>
                                                    <p class="small text-muted mb-0">تهران</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="swiper-slide">
                                    <div class="card h-100">
                                        <div class="card-body text-body d-flex flex-column justify-content-between h-100">
                                            <div class="mb-3">
                                                <span class="badge bg-label-info">تعمیرات کولر</span>
                                            </div>
                                            <p class="justify-text">کولر گازی ما اصلا خنک نمیکرد، متخصص شما خیلی سریع مشکل رو پیدا کرد و با قیمت منصفانه تعمیرش کرد.</p>
                                            <div class="text-warning mb-3">
                                                <i class="ti ti-star-filled ti-sm"></i><i class="ti ti-star-filled ti-sm"></i><i class="ti ti-star-filled ti-sm"></i><i class="ti ti-star-filled ti-sm"></i><i class="ti ti-star-filled ti-sm"></i>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar me-2 avatar-sm">
                                                    <img src="~/img/avatars/2.png" alt="Avatar" class="rounded-circle" />
                                                </div>
                                                <div>
                                                    <h6 class="mb-0">علی رضایی</h6>
                                                    <p class="small text-muted mb-0">کرج</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="swiper-slide">
                                    <div class="card h-100">
                                        <div class="card-body text-body d-flex flex-column justify-content-between h-100">
                                            <div class="mb-3">
                                                <span class="badge bg-label-warning">پذیرایی</span>
                                            </div>
                                            <p class="justify-text">برای مهمونی تولد پسرم نیرو گرفتم. خیلی حرفه‌ای پذیرایی کردن و من تونستم با خیال راحت به مهمونام برسم.</p>
                                            <div class="text-warning mb-3">
                                                <i class="ti ti-star-filled ti-sm"></i><i class="ti ti-star-filled ti-sm"></i><i class="ti ti-star-filled ti-sm"></i><i class="ti ti-star-filled ti-sm"></i><i class="ti ti-star ti-sm"></i>
                                            </div>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar me-2 avatar-sm">
                                                    <img src="~/img/avatars/3.png" alt="Avatar" class="rounded-circle" />
                                                </div>
                                                <div>
                                                    <h6 class="mb-0">مریم کاظمی</h6>
                                                    <p class="small text-muted mb-0">اصفهان</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="swiper-button-next"></div>
                            <div class="swiper-button-prev"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <hr class="m-0" />
    </section>
    <section id="landingPricing" class="section-py bg-body landing-pricing">
        <div class="container">
            <div class="text-center mb-3 pb-1">
                <span class="badge bg-label-success">همکاری با ما</span>
            </div>
            <h3 class="text-center mb-1">
                <span class="position-relative fw-bold z-1">
                    کسب درآمد
                </span>
                <span class="section-title">
                    به عنوان متخصص
                </span>
            </h3>
            <p class="text-center mb-4 pb-3">
                اگر در هر یک از خدمات فنی، نظافتی، آموزشی و ... مهارت دارید، به خانواده بزرگ متخصصین ما بپیوندید.
            </p>

            <div class="row gy-4 pt-lg-3 justify-content-center">
                <div class="col-xl-6 col-lg-8">
                    <div class="card border border-primary shadow-lg">
                        <div class="card-header text-center">
                            <img src="~/img/front-pages/icons/rocket.png" alt="rocket icon" class="mb-4 pb-2" style="width: 60px" />
                            <h4 class="mb-2">ثبت نام متخصصین</h4>
                            <p class="text-muted">همین امروز کسب و کار خود را رونق دهید</p>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <ul class="list-unstyled">
                                        <li class="mb-3">
                                            <h5 class="fw-medium fs-6">
                                                <i class="ti ti-check text-primary me-2"></i>
                                                ساعت کاری منعطف
                                            </h5>
                                        </li>
                                        <li class="mb-3">
                                            <h5 class="fw-medium fs-6">
                                                <i class="ti ti-check text-primary me-2"></i>
                                                درآمد تضمین شده
                                            </h5>
                                        </li>
                                        <li class="mb-3">
                                            <h5 class="fw-medium fs-6">
                                                <i class="ti ti-check text-primary me-2"></i>
                                                تسویه حساب روزانه
                                            </h5>
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <ul class="list-unstyled">
                                        <li class="mb-3">
                                            <h5 class="fw-medium fs-6">
                                                <i class="ti ti-check text-primary me-2"></i>
                                                بدون نیاز به سرمایه اولیه
                                            </h5>
                                        </li>
                                        <li class="mb-3">
                                            <h5 class="fw-medium fs-6">
                                                <i class="ti ti-check text-primary me-2"></i>
                                                پشتیبانی اختصاصی متخصصین
                                            </h5>
                                        </li>
                                        <li class="mb-3">
                                            <h5 class="fw-medium fs-6">
                                                <i class="ti ti-check text-primary me-2"></i>
                                                دسترسی به هزاران سفارش
                                            </h5>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="d-grid mt-4 pt-3">
                                <a href="/Specialist/Register" class="btn btn-primary btn-lg">ثبت نام رایگان متخصص</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="landingFunFacts" class="section-py landing-fun-facts">
        <div class="container">
            <div class="row gy-3">
                <div class="col-sm-6 col-lg-3">
                    <div class="card border border-label-primary shadow-none">
                        <div class="card-body text-center">
                            <img src="~/img/front-pages/icons/laptop.png" alt="laptop" class="mb-2" />
                            <h5 class="h2 mb-1">500+</h5>
                            <p class="fw-medium mb-0">
                                خدمات متنوع
                                <br />
                                قابل انجام
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border border-label-success shadow-none">
                        <div class="card-body text-center">
                            <img src="~/img/front-pages/icons/user-success.png" alt="laptop" class="mb-2" />
                            <h5 class="h2 mb-1">50k+</h5>
                            <p class="fw-medium mb-0">
                                متخصص فعال
                                <br />
                                در سراسر کشور
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border border-label-info shadow-none">
                        <div class="card-body text-center">
                            <img src="~/img/front-pages/icons/diamond-info.png" alt="laptop" class="mb-2" />
                            <h5 class="h2 mb-1">4.8/5</h5>
                            <p class="fw-medium mb-0">
                                میانگین امتیاز
                                <br />
                                رضایت مشتریان
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="card border border-label-warning shadow-none">
                        <div class="card-body text-center">
                            <img src="~/img/front-pages/icons/check-warning.png" alt="laptop" class="mb-2" />
                            <h5 class="h2 mb-1">100%</h5>
                            <p class="fw-medium mb-0">
                                بیمه مسئولیت
                                <br />
                                تمامی سفارشات
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section id="landingFAQ" class="section-py bg-body landing-faq">
        <div class="container">
            <div class="text-center mb-3 pb-1">
                <span class="badge bg-label-primary">سوالات متداول</span>
            </div>
            <h3 class="text-center mb-1">
                <span class="section-title">سوالات پرتکرار</span>
                <span class="position-relative fw-bold z-1">
                    شما
                </span>
            </h3>
            <p class="text-center mb-5 pb-3">پاسخ سوالات خود را اینجا پیدا کنید</p>
            <div class="row gy-5">
                <div class="col-lg-5">
                    <div class="text-center">
                        <img src="~/img/front-pages/landing-page/faq-boy-with-logos.png" alt="faq boy with logos" class="faq-image" />
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="accordion" id="accordionExample">
                        <div class="card accordion-item active">
                            <h2 class="accordion-header" id="headingOne">
                                <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#accordionOne" aria-expanded="true" aria-controls="accordionOne">
                                    چگونه می‌توانم به متخصصین اعتماد کنم؟
                                </button>
                            </h2>
                            <div id="accordionOne" class="accordion-collapse collapse show" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
                                    تمامی متخصصین ما پس از گذراندن مراحل مصاحبه، ارائه گواهی عدم سوء پیشینه و احراز هویت دقیق جذب می‌شوند. همچنین سیستم امتیازدهی مشتریان کیفیت کار آن‌ها را تضمین می‌کند.
                                </div>
                            </div>
                        </div>
                        <div class="card accordion-item">
                            <h2 class="accordion-header" id="headingTwo">
                                <button type="button" class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#accordionTwo" aria-expanded="false" aria-controls="accordionTwo">
                                    آیا خدمات بیمه هستند؟
                                </button>
                            </h2>
                            <div id="accordionTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#accordionExample">
                                <div class="accordion-body">
