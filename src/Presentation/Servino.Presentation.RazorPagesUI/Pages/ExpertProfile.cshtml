@page "{expertId:int}"
@using Servino.Framework.Extensions
@model Servino.Presentation.RazorPagesUI.Pages.ExpertProfileModel
@{
    Layout = "Layouts/_ContentNavbarLayout";
    ViewData["Title"] = "پروفایل متخصص";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <img src="@(!string.IsNullOrEmpty(Model.ExpertProfile.ProfileImagePath) ? Model.ExpertProfile.ProfileImagePath : "/images/default-profile.png")"
                         class="rounded-circle mb-3" alt="Profile photo" style="width: 150px; height: 150px; object-fit: cover;">
                    <h4>@Model.ExpertProfile.FirstName @Model.ExpertProfile.LastName</h4>
                    <p class="text-muted">
                        @(string.IsNullOrWhiteSpace(Model.ExpertProfile.Bio)
                            ? "بیوگرافی ثبت نشده"
                            : Model.ExpertProfile.Bio)
                    </p>
                    
                    <hr />

                    <h6 class="fw-bold">🛠 تخصص‌ها</h6>

                    @if (Model.ExpertServices.Any())
                    {
                        <ul class="list-inline mb-2">
                            @foreach (var service in Model.ExpertServices)
                            {
                                <li class="list-inline-item mb-1">
                                    <span class="badge bg-secondary">
                                        @service.HomeServiceTitle
                                    </span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted small">تخصصی ثبت نشده است</p>
                    }


                    <hr />

                    <p><strong>📧 ایمیل:</strong> @Model.ExpertProfile.Email</p>
                    <p><strong>📱 تلفن:</strong> @Model.ExpertProfile.Phone</p>
                    @if (!string.IsNullOrEmpty(Model.ExpertProfile.Address))
                    {
                        <p><strong>📍 آدرس:</strong> @Model.ExpertProfile.Address</p>
                    }

                    <hr />

                    <h6>اطلاعات مالی</h6>
                    <p><strong>💳 کارت:</strong> @(Model.ExpertProfile.BankCardNumber ?? "ثبت نشده")</p>
                    <p><strong>🏦 شِبا:</strong> @(Model.ExpertProfile.ShebaNumber ?? "ثبت نشده")</p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">دیدگاه‌های کاربران</h5>
                </div>
                <div class="card-body">
                    @if (Model.Comments.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var comment in Model.Comments)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="fw-bold mb-1">@comment.Title</h6>
                                            <p class="mb-1">@comment.Text</p>
                                            <small class="text-muted">
                                                👤 @comment.CustomerName
                                                | ⭐ امتیاز: @((int)comment.Rating)
                                                | 🕒 @comment.CreatedAt.ToShamsi();
                                            </small>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center text-muted p-3">
                            هنوز دیدگاهی ثبت نشده است.
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer text-center">
                        <nav>
                            <ul class="pagination justify-content-center mb-0">
                                @if (Model.Pagination.PageNumber > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Page("ExpertProfile", new { expertId = Model.ExpertProfile.ExpertId, pageNumber = Model.Pagination.PageNumber - 1 })">قبلی</a>
                                    </li>
                                }

                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.Pagination.PageNumber ? "active" : "")">
                                        <a class="page-link" href="@Url.Page("ExpertProfile", new { expertId = Model.ExpertProfile.ExpertId, pageNumber = i })">@i</a>
                                    </li>
                                }

                                @if (Model.Pagination.PageNumber < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link"
                                           href="@Url.Page("ExpertProfile", new { expertId = Model.ExpertProfile.ExpertId, pageNumber = Model.Pagination.PageNumber + 1 })">بعدی</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
